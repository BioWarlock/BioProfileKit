<!-- Colorblind mode toggle: persists the user's palette choice across pages via localStorage -->
<script>
    (function () {
        const btn = document.getElementById('cbToggle');
        const body = document.body;

        function applyTheme(theme) {
            body.dataset.cbTheme = theme;
            btn.setAttribute('aria-pressed', theme === 'colorblind' ? 'true' : 'false');
            btn.textContent = theme === 'colorblind' ? 'Standard Mode' : 'Colorblind Mode';
        }

        const stored = localStorage.getItem('cb-theme');
        if (stored === 'colorblind') { applyTheme('colorblind'); }

        btn.addEventListener('click', function () {
            const next = body.dataset.cbTheme === 'colorblind' ? 'internal' : 'colorblind';
            applyTheme(next);
            localStorage.setItem('cb-theme', next);
        });
    })();
</script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
