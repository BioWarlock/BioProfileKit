<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Overview of Analysis - BioProfileKit" />
    <meta name="author" content="JLU" />
    <title>General Statistics – BioProfileKit</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="static/assets/favicon.ico" />
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="static/css/bootstrap.css" rel="stylesheet" />
    <link href="static/css/cb.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.7/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.0/css/responsive.bootstrap5.min.css">
    <script src="https://cdn.plot.ly/plotly-3.3.1.min.js" charset="utf-8"></script>
</head>
<body data-cb-theme="internal">
<!-- Responsive navbar-->
<nav class="navbar navbar-expand-lg navbar-cb-dark bg-dark">
    <div class="container px-5">
        <a class="navbar-brand" href="index.html">BioProfileKit</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="index.html">Home</a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link active dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Services
                    </a>
                    <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                        <a class="dropdown-item" href="numeric_data.html">Overview of Analysis</a>
                        <a class="dropdown-item" href="columns.html">Column Analysis</a>
                        <a class="dropdown-item" aria-current="page" href="general_statistics.html">General Statistics</a>
                    </div>
                </li>
                <!-- Colorblind mode toggle: switches between default and colorblind-friendly palette -->
                <li class="nav-item ms-2 d-flex align-items-center">
                    <button id="cbToggle" type="button" class="btn btn-cb-navbar btn-sm"
                            aria-pressed="false" title="Toggle colorblind-friendly colour palette">
                        Colorblind Mode
                    </button>
                </li>
            </ul>
        </div>
    </div>
</nav>
<!-- Page Content-->
<div id="page-container">
    <div id="content-wrap">
        <div class="container px-4 px-lg-5">
            <!-- Heading Row-->
            <div class="row gx-4 gx-lg-5 align-items-center my-5">
                <div class="col-12">
                    <h1 class="font-weight-light">General Statistics</h1>
                    <p style="text-align: justify">
                    </p>
                </div>
            </div>
            <!-- Content Row-->
            <div class="row gx-4 gx-lg-5">
                <div class="col-12">
                    <div class="w-100">
                        <ul class="nav nav-tabs" id="missingTab1" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="missingTab1btn"
                                        data-bs-toggle="tab" data-bs-target="#missingTab1Target"
                                        type="button" role="tab">Missing Matrix</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="missingTab2btn"
                                        data-bs-toggle="tab" data-bs-target="#missingTab2Target"
                                        type="button" role="tab">Missing Value Barchart</button>
                            </li>
                        {% if plots.missing_mechanisms %}
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="missingTab3btn"
                                            data-bs-toggle="tab" data-bs-target="#missingTab3Target"
                                            type="button" role="tab">Missing Mechanisms</button>
                                </li>
                        {% endif %}
                        {% if plots.mcar_result %}
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="missingTab4btn"
                                            data-bs-toggle="tab" data-bs-target="#missingTab4Target"
                                            type="button" role="tab">Little&rsquo;s MCAR Test</button>
                                </li>
                        {% endif %}
                        </ul>
                        <div class="tab-content" id="objectTabContent">
                            <div class="tab-pane fade show active" id="missingTab1Target" role="tabpanel" aria-labelledby="missingTab1btn">
                                <div class="w-100">
                                    <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                        <figure role="img" aria-label="Missing value matrix showing which cells are missing across all columns">
                                            {{ plots.missing_matrix | safe }}
                                        </figure>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="missingTab2Target" role="tabpanel" aria-labelledby="missingTab2btn">
                                <div class="w-100">
                                    <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                        <figure role="img" aria-label="Bar chart showing the percentage of missing values per column">
                                            {{ plots.missing_values_barchart | safe }}
                                        </figure>
                                    </div>
                                </div>
                            </div>
                        <!-- TODO: Add Missing Mechanisms tab if needed and Little's MCAR test is implemented -->
                          {% if plots.missing_mechanisms %}
                        <div class="tab-pane fade" id="missingTab3Target" role="tabpanel" aria-labelledby="missingTab3btn">
                            <div class="w-100 mt-3 mb-5">

                                <div class="table-responsive mb-4" style="max-height: 400px; overflow-y: auto;">
                                    <table class="table table-sm table-striped w-100">
                                        <caption>Statistical test results for missing data mechanisms per column</caption>
                                        <thead class="sticky-top bg-light">
                                        <tr>
                                            <th>Column</th>
                                            <th>Missing Count</th>
                                            <th>Mechanism</th>
                                            <th>p-Value</th>
                                            <th>Test</th>
                                            <th>Related Column</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for col_name, info in plots.missing_mechanisms.items() %}
                                            <tr>
                                                <td>{{ col_name }}</td>
                                                <td>{{ info.count }}</td>
                                                <td>
                                                    {% if info.mechanism == 'MAR' %}
                                                        <span class="badge bg-warning">{{ info.mechanism }}</span>
                                                    {% else %}
                                                        <span class="badge bg-success">{{ info.mechanism }}</span>
                                                    {% endif %}
                                                </td>
                                                <td>{{ info.p_value }}</td>
                                                <td>{{ info.test if info.test else '—' }}</td>
                                                <td>{{ info.related_col if info.related_col else '—' }}</td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                                <div class="alert alert-light mt-3">
                                    <div class="small text-muted">
                                    <strong>MCAR:</strong> Missing Completely At Random — no pattern detected; safe to drop or impute simply.<br>
                                        <strong>MAR:</strong> Missing At Random — missingness depends on other observed columns <i>(p &lt; 0.05)</i>.<br>
                                    <hr>
                                        <strong>Mann-Whitney U:</strong>Tests whether a numeric column has a different distribution when the target column is missing versus present. A significant result <i>(p &lt; 0.05)</i> suggests the missingness is related to that numeric column.<br>
                                    <strong>Chi-Squared:</strong> Tests whether the missing patterns of two columns are statistically associated. A significant result suggests the columns tend to be missing together.
                                    <hr>
                                    These results are statistical estimates derived from hypothesis testing and should be interpreted cautiously.
                                    MNAR (Missing Not At Random) cannot be detected from the observed data alone and may require domain knowledge.
                                    A single significant test does not confirm a specific mechanism — consider the overall context of your dataset.
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                        {% if plots.mcar_result %}
                        <div class="tab-pane fade" id="missingTab4Target" role="tabpanel" aria-labelledby="missingTab4btn">
                            <div class="w-100 mt-3 mb-5">
                                {% if plots.mcar_result is mapping and plots.mcar_result.keys() | list == ['Hello'] %}
                                    {# Placeholder result from littles_mcar_test stub #}
                                    <div class="alert alert-info">
                                        <strong>Little&rsquo;s MCAR Test</strong> is not yet fully implemented.
                                        Results will appear here once the statistical test is complete.
                                    </div>
                                {% else %}
                                    <div class="table-responsive mb-4" style="max-height: 400px; overflow-y: auto;">
                                        <table class="table table-sm table-striped w-100">
                                            <caption>Little&rsquo;s MCAR test result for the full dataset</caption>
                                            <thead class="sticky-top bg-light">
                                            <tr>
                                                <th>Metric</th>
                                                <th>Value</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            {% for key, value in plots.mcar_result.items() %}
                                                <tr>
                                                    <td><strong>{{ key }}</strong></td>
                                                    <td>{{ value }}</td>
                                                </tr>
                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="alert alert-light mt-3">
                                        <div class="small text-muted">
                                            <strong>Little&rsquo;s MCAR Test:</strong> Tests whether data is Missing Completely At Random.
                                            A significant p-value <i>(p &lt; 0.05)</i> suggests the data is <em>not</em> MCAR —
                                            missingness may depend on observed or unobserved values.
                                            <hr>
                                            MNAR (Missing Not At Random) cannot be detected from the observed data alone
                                            and may require domain knowledge.
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        {% endif %}
                        </div>
                    </div>
                </div>
                <hr>
                <div class="col-12">
                    <div class="w-100">
                        <h5 class="mb-1">Strong Associations
                            <small class="text-muted fw-normal ms-1" style="font-size:0.8em;">threshold &ge; 0.7</small>
                        </h5>
                        <p class="text-muted mb-3" style="font-size:0.85em;">
                            Column pairs with an association strength &ge; 0.7 across all applicable methods.
                            Method is determined automatically by column type (Pearson / Cramér&rsquo;s&nbsp;V / Eta&sup2;).
                            A 0.7 Pearson and a 0.7 Cramér’s V are not directly comparable.
                        </p>
                        {% if plots.top_associations %}
                            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                <table class="table table-sm table-striped w-100">
                                    <thead class="sticky-top bg-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Variable 1</th>
                                        <th>Variable 2</th>
                                        <th>Strength</th>
                                        <th style="min-width:160px;">Distribution</th>
                                        <th>Method</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for pair in plots.top_associations %}
                                        {% set pct = (pair.value * 100) | round(1) %}
                                        <tr>
                                            <td class="text-muted">{{ loop.index }}</td>
                                            <td class="font-monospace">{{ pair.var1 }}</td>
                                            <td class="font-monospace">{{ pair.var2 }}</td>
                                            <td>
                                                <strong>{{ "%.3f"|format(pair.value) }}</strong>
                                            </td>
                                            <td>
                                                <div class="progress" style="height:14px;">
                                                    <div class="progress-bar
                                                        {% if pair.value >= 0.9 %}bg-danger
                                                        {% elif pair.value >= 0.8 %}bg-warning
                                                        {% else %}bg-primary{% endif %}"
                                                         role="progressbar"
                                                         style="width:{{ pct }}%"
                                                         aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100">
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge
                                                    {% if pair.method == 'Pearson' %}bg-secondary
                                                    {% elif pair.method == "Cramér's V" %}bg-info text-dark
                                                    {% else %}bg-secondary{% endif %}"
                                                      style="font-size:0.75em;">
                                                    {{ pair.method }}
                                                </span>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="alert alert-success">
                                No column pairs exceed the association threshold of 0.7 — no strong associations detected.
                            </div>
                        {% endif %}
                    </div>
                </div>

                {% if plots.feature_target_plot or plots.feature_target_correlation %}
                <hr>
                    <div class="col-12">
                        <h5 class="mb-3">Feature–Target Association</h5>
                        <div class="row">
                            {% if plots.feature_target_plot %}
                                <div class="col-lg-7">
                                    <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                        <figure role="img" aria-label="Horizontal bar chart showing association strength of each feature with the target column">
                                            {{ plots.feature_target_plot | safe }}
                                        </figure>
                                    </div>
                                </div>
                            {% endif %}
                            {% if plots.feature_target_correlation %}
                                <div class="col-lg-5">
                                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                        <table class="table table-sm table-striped w-100">
                                            <thead class="sticky-top bg-light">
                                            <tr>
                                                <th>Feature</th>
                                                <th>Strength</th>
                                                <th>Method</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            {% for feature, info in plots.feature_target_correlation.items() | sort(attribute='1.value', reverse=true) %}
                                                <tr>
                                                    <td class="font-monospace">{{ feature }}</td>
                                                    <td>
                                                        <strong>{{ "%.3f"|format(info.value) }}</strong>
                                                        <div class="progress mt-1" style="height:8px;">
                                                            <div class="progress-bar
                                                                {% if info.value >= 0.7 %}bg-danger
                                                                {% elif info.value >= 0.3 %}bg-warning
                                                                {% else %}bg-secondary{% endif %}"
                                                                 role="progressbar"
                                                                 style="width:{{ (info.value * 100) | round(1) }}%">
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="badge
                                                            {% if info.method == 'Pearson' %}bg-secondary
                                                            {% elif info.method == "Cramér's V" %}bg-info text-dark
                                                            {% else %}bg-secondary{% endif %}"
                                                              style="font-size:0.75em;">
                                                            {{ info.method }}
                                                        </span>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {% if plots.mutual_information or plots.mutual_information_plot or plots.mi_relationship_plots %}
                <hr>
                    <div class="col-12">
                        <h5 class="mb-1">Mutual Information
                            <small class="text-muted fw-normal ms-1" style="font-size:0.8em;">feature → target, non-linear</small>
                        </h5>
                        <p class="text-muted mb-3" style="font-size:0.85em;">
                            Mutual information measures non-linear statistical dependency between each feature and the target.
                            Unlike correlation, it captures any kind of relationship — not just linear ones.
                            Values are non-negative and unbounded; higher means more information shared.
                        </p>

                        <ul class="nav nav-tabs" id="miTabs" role="tablist">
                            {% if plots.mutual_information_plot %}
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="miPlotBtn"
                                            data-bs-toggle="tab" data-bs-target="#miPlotTarget"
                                            type="button" role="tab" aria-selected="true">
                                        Ranking
                                    </button>
                                </li>
                            {% endif %}
                            {% if plots.mutual_information %}
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link {% if not plots.mutual_information_plot %}active{% endif %}"
                                            id="miTableBtn"
                                            data-bs-toggle="tab" data-bs-target="#miTableTarget"
                                            type="button" role="tab"
                                            aria-selected="{{ 'true' if not plots.mutual_information_plot else 'false' }}">
                                        Table
                                    </button>
                                </li>
                            {% endif %}
                            {% if plots.mi_relationship_plots %}
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="miRelBtn"
                                            data-bs-toggle="tab" data-bs-target="#miRelTarget"
                                            type="button" role="tab" aria-selected="false">
                                        Top Relationships
                                        <span class="badge bg-secondary ms-1" style="font-size:0.7em;">
                                            Top {{ plots.mi_relationship_plots | length }}
                                        </span>
                                    </button>
                                </li>
                            {% endif %}
                        </ul>

                        <div class="tab-content" id="miTabContent">

                            {# ── Ranking plot ── #}
                            {% if plots.mutual_information_plot %}
                                <div class="tab-pane fade show active" id="miPlotTarget"
                                     role="tabpanel" aria-labelledby="miPlotBtn">
                                    <div class="plot-container mb-4 mt-2" style="max-height: fit-content; overflow: scroll;">
                                        <figure role="img" aria-label="Horizontal bar chart of mutual information scores per feature">
                                            {{ plots.mutual_information_plot | safe }}
                                        </figure>
                                    </div>
                                </div>
                            {% endif %}

                            {# ── Table ── #}
                            {% if plots.mutual_information %}
                                <div class="tab-pane fade {% if not plots.mutual_information_plot %}show active{% endif %}"
                                     id="miTableTarget" role="tabpanel" aria-labelledby="miTableBtn">
                                    <div class="table-responsive mt-3" style="max-height: 450px; overflow-y: auto;">
                                        <table class="table table-sm table-striped w-100">
                                            <thead class="sticky-top bg-light">
                                            <tr>
                                                <th>#</th>
                                                <th>Feature</th>
                                                <th>MI Score</th>
                                                <th style="min-width:160px;">Relative Strength</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            {% set max_mi = plots.mutual_information.values() | map(attribute='value') | max %}
                                            {% for feature, info in plots.mutual_information.items() | sort(attribute='1.value', reverse=true) %}
                                                {% set pct = ((info.value / max_mi) * 100) | round(1) if max_mi > 0 else 0 %}
                                                <tr>
                                                    <td class="text-muted">{{ loop.index }}</td>
                                                    <td class="font-monospace">{{ feature }}</td>
                                                    <td><strong>{{ "%.4f"|format(info.value) }}</strong></td>
                                                    <td>
                                                        <div class="progress" style="height:14px;">
                                                            <div class="progress-bar bg-primary"
                                                                 role="progressbar"
                                                                 style="width:{{ pct }}%"
                                                                 aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100">
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            {% endif %}

                            {# ── Top Relationship plots ── #}
                            {% if plots.mi_relationship_plots %}
                                <div class="tab-pane fade" id="miRelTarget"
                                     role="tabpanel" aria-labelledby="miRelBtn">
                                    <p class="text-muted mt-3 mb-2" style="font-size:0.85em;">
                                        Pairwise relationship plots for the top {{ plots.mi_relationship_plots | length }} features
                                        by mutual information score. Plot type adapts automatically to column types.
                                    </p>
                                    <div class="row mt-2">
                                        {% for item in plots.mi_relationship_plots %}
                                            <div class="col-12 mb-4">
                                                <div class="d-flex align-items-center mb-1">
                                                    <span class="font-monospace fw-bold me-2">{{ item.feature }}</span>
                                                    <span class="badge bg-secondary" style="font-size:0.75em;">
                                                        MI = {{ "%.4f"|format(item.value) }}
                                                    </span>
                                                </div>
                                                <div class="plot-container" style="max-height: fit-content; overflow: scroll;">
                                                    <figure role="img" aria-label="Relationship plot between {{ item.feature }} and target">
                                                        {{ item.plot | safe }}
                                                    </figure>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}

                        </div>{# /tab-content #}
                    </div>
                {% endif %}

                {% if plots.balance_plot %}
                <hr>
                    <div class="col-12">
                        <div class="w-100">
                            <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                <figure role="img" aria-label="Balance plot showing class distribution across categorical columns">
                                    {{ plots.balance_plot | safe }}
                                </figure>
                            </div>
                        </div>
                    </div>
                {% endif %}
                <hr>
                <div class="col-12">
                    <div class="w-100">
                        <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                            <figure role="img" aria-label="Boxplot showing value distributions and outliers for all numeric columns">
                                {{ plots.boxplot | safe }}
                            </figure>
                        </div>
                    </div>
                </div>
                <hr>
                <div class="col-12">
                    <div class="w-100">
                        <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                            <figure role="img" aria-label="Scatter matrix showing pairwise relationships between all numeric columns">
                                {{ plots.scatter_matrix | safe }}
                            </figure>
                        </div>
                    </div>
                </div>
                <hr>
                <div class="col-12">
                    <div class="w-100">
                        <h5 class="mb-3">Correlation Plots</h5>

                        <ul class="nav nav-tabs" id="corrPlotTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="corrPearsonBtn"
                                        data-bs-toggle="tab" data-bs-target="#corrPearsonTarget"
                                        type="button" role="tab" aria-selected="true">
                                    Pearson
                                    <span class="badge bg-secondary ms-1" style="font-size:0.7em;">numeric</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="corrCramersBtn"
                                        data-bs-toggle="tab" data-bs-target="#corrCramersTarget"
                                        type="button" role="tab" aria-selected="false">
                                    Cramér&rsquo;s&nbsp;V
                                    <span class="badge bg-secondary ms-1" style="font-size:0.7em;">categorical</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="corrEtaBtn"
                                        data-bs-toggle="tab" data-bs-target="#corrEtaTarget"
                                        type="button" role="tab" aria-selected="false">
                                    Eta&sup2;
                                    <span class="badge bg-secondary ms-1" style="font-size:0.7em;">mixed</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="corrAssocBtn"
                                        data-bs-toggle="tab" data-bs-target="#corrAssocTarget"
                                        type="button" role="tab" aria-selected="false">
                                    Association Heatmap
                                    <span class="badge bg-secondary ms-1" style="font-size:0.7em;">all types</span>
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="corrPlotContent">

                            {# ── Association Heatmap (combined) ── #}
                            <div class="tab-pane fade" id="corrAssocTarget"
                                 role="tabpanel" aria-labelledby="corrAssocBtn">
                                <p class="text-muted mt-3 mb-2" style="font-size: 0.85em;">
                                    Absolute association strengths in [0,&thinsp;1]. Methods differ by variable type (hover for detail):
                                    Pearson for numeric pairs, Cramér&rsquo;s&nbsp;V for categorical pairs, Eta&sup2; for mixed.
                                    A&nbsp;0.7&nbsp;Pearson and a&nbsp;0.7&nbsp;Cramér&rsquo;s&nbsp;V are not directly comparable.
                                </p>
                                {% if plots.correlation_heatmap %}
                                    <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                        <figure role="img" aria-label="Combined association heatmap using Pearson, Cramér's V and Eta squared depending on column type">
                                            {{ plots.correlation_heatmap | safe }}
                                        </figure>
                                    </div>
                                {% else %}
                                    <div class="alert alert-secondary mt-3">
                                        Association heatmap not available.
                                    </div>
                                {% endif %}
                            </div>

                            {# ── Pearson ── #}
                            <div class="tab-pane fade show active" id="corrPearsonTarget"
                                 role="tabpanel" aria-labelledby="corrPearsonBtn">
                                {% if plots.pearson_heatmap %}
                                    <div class="plot-container mb-4 mt-2" style="max-height: fit-content; overflow: scroll;">
                                        <figure role="img" aria-label="Pearson correlation heatmap for numeric column pairs">
                                            {{ plots.pearson_heatmap | safe }}
                                        </figure>
                                    </div>
                                {% else %}
                                    <div class="alert alert-secondary mt-3">
                                        No numeric column pairs with non-zero variance found — Pearson heatmap not available.
                                    </div>
                                {% endif %}
                            </div>

                            {# ── Cramér's V ── #}
                            <div class="tab-pane fade" id="corrCramersTarget"
                                 role="tabpanel" aria-labelledby="corrCramersBtn">
                                {% if plots.cramers_heatmap %}
                                    <div class="plot-container mb-4 mt-2" style="max-height: fit-content; overflow: scroll;">
                                        <figure role="img" aria-label="Cramér's V heatmap for categorical column pairs">
                                            {{ plots.cramers_heatmap | safe }}
                                        </figure>
                                    </div>
                                {% else %}
                                    <div class="alert alert-secondary mt-3">
                                        At least two categorical columns are required — Cramér&rsquo;s&nbsp;V heatmap not available.
                                    </div>
                                {% endif %}
                            </div>

                            {# ── Eta² ── #}
                            <div class="tab-pane fade" id="corrEtaTarget"
                                 role="tabpanel" aria-labelledby="corrEtaBtn">
                                {% if plots.eta_heatmap %}
                                    <div class="plot-container mb-4 mt-2" style="max-height: fit-content; overflow: scroll;">
                                        <figure role="img" aria-label="Eta squared heatmap showing variance in numeric columns explained by categorical columns">
                                            {{ plots.eta_heatmap | safe }}
                                        </figure>
                                    </div>
                                {% else %}
                                    <div class="alert alert-secondary mt-3">
                                        At least one categorical and one numeric column are required — Eta&sup2; heatmap not available.
                                    </div>
                                {% endif %}
                            </div>

                        </div>{# /tab-content #}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Footer-->
    <footer class="py-5 bg-dark d-flex flex-column justify-content-center align-items-center" id="footer">
        <div class="mb-2">
            <a href="https://github.com/BioWarlockBioProfileKit">
                <img src="static/assets/github.svg" alt="BioProfileKit on GitHub" style="filter: brightness(0) invert(1);">
            </a>
        </div>
        <div>
            <p class="m-0 text-center text-white">Copyright &copy; JLU 2025</p>
        </div>
    </footer>
</div>

