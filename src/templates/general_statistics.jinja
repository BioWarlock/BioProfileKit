<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Multivariate Statistics - BioProfileKit" />
    <meta name="author" content="JLU" />
    <title>Multivariate Statistics – BioProfileKit</title>
    <link rel="icon" type="image/x-icon" href="static/assets/favicon.ico" />
    <link href="static/css/bootstrap.css" rel="stylesheet" />
    <link href="static/css/cb.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.7/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.0/css/responsive.bootstrap5.min.css">
    <script src="https://cdn.plot.ly/plotly-3.3.1.min.js" charset="utf-8"></script>
    <style>
        /* Section headings */
        .section-heading {
            font-size: 1.1rem;
            font-weight: 600;
            letter-spacing: .02em;
            color: var(--cb-text, #1A1A1A);
            border-left: 3px solid var(--cb-primary, #0F65A0);
            padding-left: .6rem;
            margin-bottom: 1rem;
        }
        /* DataTables font consistency */
        .dataTables_wrapper,
        .dataTables_wrapper table,
        .dataTables_wrapper input,
        .dataTables_wrapper select {
            font-family: inherit;
            font-size: 0.875rem;
        }
        /* Strength cell: number + bar in one cell */
        .strength-cell { min-width: 140px; }
        .strength-bar  { height: 6px; border-radius: 3px; margin-top: 3px; background: #e9ecef; }
        .strength-bar-fill { height: 100%; border-radius: 3px; }
    </style>
</head>
<body data-cb-theme="internal">

<nav class="navbar navbar-expand-lg navbar-cb-dark bg-dark">
    <div class="container px-5">
        <a class="navbar-brand" href="index.html">BioProfileKit</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="index.html">Home</a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link active dropdown-toggle" href="#" id="navbarDropdown"
                       role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Services
                    </a>
                    <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                        <a class="dropdown-item" href="numeric_data.html">Overview of Analysis</a>
                        <a class="dropdown-item" href="columns.html">Column Analysis</a>
                        <a class="dropdown-item" aria-current="page" href="general_statistics.html">Multivariate Statistics</a>
                    </div>
                </li>
                <li class="nav-item ms-2 d-flex align-items-center">
                    <button id="cbToggle" type="button" class="btn btn-cb-navbar btn-sm"
                            aria-pressed="false" title="Toggle colorblind-friendly colour palette">
                        Colorblind Mode
                    </button>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div id="page-container">
  <div id="content-wrap">
    <div class="container px-4 px-lg-5">

      <!-- Page heading -->
      <div class="row gx-4 gx-lg-5 align-items-center my-5">
        <div class="col-12">
          <h1 class="font-weight-light">Multivariate Statistics</h1>
        </div>
      </div>

      <div class="row gx-4 gx-lg-5">
        <div class="col-12">

          {# ================================================================
             1) MISSINGNESS
             ================================================================ #}
          <p class="section-heading">Missingness</p>

          <ul class="nav nav-tabs" id="missingTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="missingTab1btn"
                      data-bs-toggle="tab" data-bs-target="#missingTab1Target"
                      type="button" role="tab">Missing Matrix</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="missingTab2btn"
                      data-bs-toggle="tab" data-bs-target="#missingTab2Target"
                      type="button" role="tab">Missing Value Barchart</button>
            </li>
            {% if plots.missing_mechanisms %}
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="missingTab3btn"
                      data-bs-toggle="tab" data-bs-target="#missingTab3Target"
                      type="button" role="tab">Missing Mechanisms</button>
            </li>
            {% endif %}
            {% if plots.mcar_result %}
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="missingTab4btn"
                      data-bs-toggle="tab" data-bs-target="#missingTab4Target"
                      type="button" role="tab">Little&rsquo;s MCAR Test</button>
            </li>
            {% endif %}
          </ul>

          <div class="tab-content mb-5" id="missingTabContent">
            <div class="tab-pane fade show active" id="missingTab1Target" role="tabpanel">
              <div class="plot-container" style="max-height:fit-content;overflow:scroll;">
                <figure role="img" aria-label="Missing value matrix">
                  {{ plots.missing_matrix | safe }}
                </figure>
              </div>
            </div>
            <div class="tab-pane fade" id="missingTab2Target" role="tabpanel">
              <div class="plot-container" style="max-height:fit-content;overflow:scroll;">
                <figure role="img" aria-label="Missing values per column bar chart">
                  {{ plots.missing_values_barchart | safe }}
                </figure>
              </div>
            </div>
            {% if plots.missing_mechanisms %}
            <div class="tab-pane fade" id="missingTab3Target" role="tabpanel">
              <div class="mt-3">
                <div class="table-responsive">
                  <table class="table table-sm table-striped w-100 dt-table" id="tblMissingMech">
                    <caption class="visually-hidden">Missing data mechanisms per column</caption>
                    <thead>
                    <tr>
                      <th>Column</th>
                      <th>Missing Count</th>
                      <th>Mechanism</th>
                      <th>p-Value</th>
                      <th>Test</th>
                      <th>Related Column</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for col_name, info in plots.missing_mechanisms.items() %}
                    <tr>
                      <td class="font-monospace">{{ col_name }}</td>
                      <td>{{ info.count }}</td>
                      <td>
                        {% if info.mechanism == 'MAR' %}
                          <span class="badge bg-warning">{{ info.mechanism }}</span>
                        {% else %}
                          <span class="badge bg-success">{{ info.mechanism }}</span>
                        {% endif %}
                      </td>
                      <td>{{ info.p_value }}</td>
                      <td>{{ info.test if info.test else '—' }}</td>
                      <td class="font-monospace">{{ info.related_col if info.related_col else '—' }}</td>
                    </tr>
                    {% endfor %}
                    </tbody>
                  </table>
                </div>
                <div class="alert alert-light mt-3 small text-muted">
                  <strong>MCAR:</strong> Missing Completely At Random — safe to drop or impute simply.<br>
                  <strong>MAR:</strong> Missing At Random — missingness depends on other observed columns <i>(p&nbsp;&lt;&nbsp;0.05)</i>.<br>
                  <hr class="my-2">
                  <strong>Mann-Whitney&nbsp;U:</strong> Tests numeric distribution difference when target is missing vs. present.<br>
                  <strong>Chi-Squared:</strong> Tests whether missing patterns of two columns are associated.<br>
                  <hr class="my-2">
                  Results are statistical estimates — interpret cautiously. MNAR cannot be detected from observed data alone.
                </div>
              </div>
            </div>
            {% endif %}
            {% if plots.mcar_result %}
            <div class="tab-pane fade" id="missingTab4Target" role="tabpanel">
              <div class="mt-3">
                {% if plots.mcar_result is mapping and plots.mcar_result.keys() | list == ['Hello'] %}
                  <div class="alert alert-info">
                    <strong>Little&rsquo;s MCAR Test</strong> is not yet fully implemented.
                    Results will appear here once the statistical test is complete.
                  </div>
                {% else %}
                  <div class="table-responsive" style="max-height:400px;overflow-y:auto;">
                    <table class="table table-sm table-striped w-100">
                      <caption class="visually-hidden">Little&rsquo;s MCAR test result</caption>
                      <thead class="sticky-top bg-light">
                      <tr><th>Metric</th><th>Value</th></tr>
                      </thead>
                      <tbody>
                      {% for key, value in plots.mcar_result.items() %}
                      <tr><td><strong>{{ key }}</strong></td><td>{{ value }}</td></tr>
                      {% endfor %}
                      </tbody>
                    </table>
                  </div>
                  <div class="alert alert-light mt-3 small text-muted">
                    <strong>Little&rsquo;s MCAR Test:</strong> p&nbsp;&lt;&nbsp;0.05 suggests data is <em>not</em> MCAR.
                    MNAR cannot be detected from observed data alone.
                  </div>
                {% endif %}
              </div>
            </div>
            {% endif %}
          </div>

          <hr>

          {# ================================================================
             2) CORRELATIONS
             ================================================================ #}
          <p class="section-heading">Correlations</p>

          {# ── Correlation heatmap tabs: Association first, then individual ── #}
          <ul class="nav nav-tabs" id="corrPlotTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="corrAssocBtn"
                      data-bs-toggle="tab" data-bs-target="#corrAssocTarget"
                      type="button" role="tab" aria-selected="true">
                Association Heatmap
                <span class="badge bg-secondary ms-1" style="font-size:.7em;">all types</span>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="corrStrongBtn"
                      data-bs-toggle="tab" data-bs-target="#corrStrongTarget"
                      type="button" role="tab" aria-selected="false">
                Strong Associations
                <span class="badge bg-secondary ms-1" style="font-size:.7em;">&ge; 0.7</span>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="corrPearsonBtn"
                      data-bs-toggle="tab" data-bs-target="#corrPearsonTarget"
                      type="button" role="tab" aria-selected="false">
                Pearson
                <span class="badge bg-secondary ms-1" style="font-size:.7em;">numeric</span>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="corrCramersBtn"
                      data-bs-toggle="tab" data-bs-target="#corrCramersTarget"
                      type="button" role="tab" aria-selected="false">
                Cramér&rsquo;s&nbsp;V
                <span class="badge bg-secondary ms-1" style="font-size:.7em;">categorical</span>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="corrEtaBtn"
                      data-bs-toggle="tab" data-bs-target="#corrEtaTarget"
                      type="button" role="tab" aria-selected="false">
                Eta&sup2;
                <span class="badge bg-secondary ms-1" style="font-size:.7em;">mixed</span>
              </button>
            </li>
          </ul>

          <div class="tab-content mb-5" id="corrPlotContent">

            {# Association Heatmap (combined) #}
            <div class="tab-pane fade show active" id="corrAssocTarget" role="tabpanel">
              <p class="text-muted mt-3 mb-2" style="font-size:.85em;">
                Absolute association strengths in [0,&thinsp;1]. Methods differ by variable type (hover for detail):
                Pearson for numeric pairs, Cramér&rsquo;s&nbsp;V for categorical pairs, Eta&sup2; for mixed.
                A&nbsp;0.7&nbsp;Pearson and a&nbsp;0.7&nbsp;Cramér&rsquo;s&nbsp;V are not directly comparable.
              </p>
              {% if plots.correlation_heatmap %}
                <div class="plot-container" style="max-height:fit-content;overflow:scroll;">
                  <figure role="img" aria-label="Combined association heatmap">
                    {{ plots.correlation_heatmap | safe }}
                  </figure>
                </div>
              {% else %}
                <div class="alert alert-secondary mt-3">Association heatmap not available.</div>
              {% endif %}
            </div>

            {# Strong Associations table #}
            <div class="tab-pane fade" id="corrStrongTarget" role="tabpanel">
              <div class="mt-3">
                <p class="text-muted small mb-3">
                  Column pairs with association &ge;&nbsp;0.7. Method is chosen automatically by column type.
                  Values from different methods are not directly comparable.
                </p>
                {% if plots.top_associations %}
                  <div class="table-responsive">
                    <table class="table table-sm table-striped w-100 dt-table" id="tblStrongAssoc">
                      <thead>
                      <tr>
                        <th>Variable 1</th>
                        <th>Variable 2</th>
                        <th>Strength</th>
                        <th>Method</th>
                      </tr>
                      </thead>
                      <tbody>
                      {% for pair in plots.top_associations %}
                        {% set pct = (pair.value * 100) | round(1) %}
                        <tr>
                          <td class="font-monospace">{{ pair.var1 }}</td>
                          <td class="font-monospace">{{ pair.var2 }}</td>
                          <td class="strength-cell" data-order="{{ pair.value }}">
                            <strong>{{ "%.3f"|format(pair.value) }}</strong>
                            <div class="strength-bar">
                              <div class="strength-bar-fill {% if pair.value >= 0.9 %}bg-danger{% elif pair.value >= 0.8 %}bg-warning{% else %}bg-primary{% endif %}"
                                   style="width:{{ pct }}%"></div>
                            </div>
                          </td>
                          <td>
                            <span class="badge {% if pair.method == 'Pearson' %}bg-secondary{% elif pair.method == "Cramér's V" %}bg-info text-dark{% else %}bg-secondary{% endif %}"
                                  style="font-size:.75em;">{{ pair.method }}</span>
                          </td>
                        </tr>
                      {% endfor %}
                      </tbody>
                    </table>
                  </div>
                {% else %}
                  <div class="alert alert-success">No column pairs exceed the association threshold of 0.7.</div>
                {% endif %}
              </div>
            </div>

            {# Pearson #}
            <div class="tab-pane fade" id="corrPearsonTarget" role="tabpanel">
              {% if plots.pearson_heatmap %}
                <div class="plot-container mt-2" style="max-height:fit-content;overflow:scroll;">
                  <figure role="img" aria-label="Pearson correlation heatmap">{{ plots.pearson_heatmap | safe }}</figure>
                </div>
              {% else %}
                <div class="alert alert-secondary mt-3">No numeric column pairs — Pearson heatmap not available.</div>
              {% endif %}
            </div>

            {# Cramér's V #}
            <div class="tab-pane fade" id="corrCramersTarget" role="tabpanel">
              {% if plots.cramers_heatmap %}
                <div class="plot-container mt-2" style="max-height:fit-content;overflow:scroll;">
                  <figure role="img" aria-label="Cramér's V heatmap">{{ plots.cramers_heatmap | safe }}</figure>
                </div>
              {% else %}
                <div class="alert alert-secondary mt-3">At least two categorical columns required — Cramér&rsquo;s&nbsp;V not available.</div>
              {% endif %}
            </div>

            {# Eta² #}
            <div class="tab-pane fade" id="corrEtaTarget" role="tabpanel">
              {% if plots.eta_heatmap %}
                <div class="plot-container mt-2" style="max-height:fit-content;overflow:scroll;">
                  <figure role="img" aria-label="Eta squared heatmap">{{ plots.eta_heatmap | safe }}</figure>
                </div>
              {% else %}
                <div class="alert alert-secondary mt-3">At least one categorical and one numeric column required — Eta&sup2; not available.</div>
              {% endif %}
            </div>

          </div>{# /corrPlotContent #}

          <hr>

          {# ================================================================
             3) TARGET  (only rendered when a target column was specified)
             ================================================================ #}
          {% if plots.feature_target_plot or plots.feature_target_correlation
                or plots.mutual_information or plots.mutual_information_plot
                or plots.mi_relationship_plots or plots.balance_plot %}

          <p class="section-heading">Target</p>

            {# ── Feature–Target Association ── #}
            {% if plots.feature_target_plot or plots.feature_target_correlation %}
            <h6 class="text-muted fw-normal mb-3" style="font-size:.9rem;">Feature–Target Association</h6>
            <div class="row mb-4">
              {% if plots.feature_target_plot %}
              <div class="col-lg-7">
                <div class="plot-container" style="max-height:fit-content;overflow:scroll;">
                  <figure role="img" aria-label="Feature-target association bar chart">
                    {{ plots.feature_target_plot | safe }}
                  </figure>
                </div>
              </div>
              {% endif %}
              {% if plots.feature_target_correlation %}
              <div class="col-lg-5">
                <div class="table-responsive">
                  <table class="table table-sm table-striped w-100 dt-table" id="tblFeatTarget">
                    <thead>
                    <tr>
                      <th>Feature</th>
                      <th>Strength</th>
                      <th>Method</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for feature, info in plots.feature_target_correlation.items() | sort(attribute='1.value', reverse=true) %}
                    <tr>
                      <td class="font-monospace">{{ feature }}</td>
                      <td class="strength-cell" data-order="{{ info.value }}">
                        <strong>{{ "%.3f"|format(info.value) }}</strong>
                        <div class="strength-bar">
                          <div class="strength-bar-fill {% if info.value >= 0.7 %}bg-danger{% elif info.value >= 0.3 %}bg-warning{% else %}bg-secondary{% endif %}"
                               style="width:{{ (info.value * 100) | round(1) }}%"></div>
                        </div>
                      </td>
                      <td>
                        <span class="badge {% if info.method == 'Pearson' %}bg-secondary{% elif info.method == "Cramér's V" %}bg-info text-dark{% else %}bg-secondary{% endif %}"
                              style="font-size:.75em;">{{ info.method }}</span>
                      </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                  </table>
                </div>
              </div>
              {% endif %}
            </div>
            {% endif %}

            {# ── Mutual Information ── #}
            {% if plots.mutual_information or plots.mutual_information_plot or plots.mi_relationship_plots %}
            <h6 class="text-muted fw-normal mb-2" style="font-size:.9rem;">
              Mutual Information
              <small class="ms-1" style="font-size:.85em;">feature → target, non-linear</small>
            </h6>
            <p class="text-muted mb-3" style="font-size:.85em;">
              Mutual information measures non-linear statistical dependency between each feature and the target.
              Unlike correlation, it captures any kind of relationship. Values are non-negative and unbounded —
              higher means more information shared.
            </p>

            <ul class="nav nav-tabs" id="miTabs" role="tablist">
              {% if plots.mutual_information_plot %}
              <li class="nav-item" role="presentation">
                <button class="nav-link active" id="miPlotBtn"
                        data-bs-toggle="tab" data-bs-target="#miPlotTarget"
                        type="button" role="tab" aria-selected="true">Ranking</button>
              </li>
              {% endif %}
              {% if plots.mutual_information %}
              <li class="nav-item" role="presentation">
                <button class="nav-link {% if not plots.mutual_information_plot %}active{% endif %}"
                        id="miTableBtn" data-bs-toggle="tab" data-bs-target="#miTableTarget"
                        type="button" role="tab"
                        aria-selected="{{ 'true' if not plots.mutual_information_plot else 'false' }}">
                  Table
                </button>
              </li>
              {% endif %}
              {% if plots.mi_relationship_plots %}
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="miRelBtn"
                        data-bs-toggle="tab" data-bs-target="#miRelTarget"
                        type="button" role="tab" aria-selected="false">
                  Top Relationships
                  <span class="badge bg-secondary ms-1" style="font-size:.7em;">
                    Top {{ plots.mi_relationship_plots | length }}
                  </span>
                </button>
              </li>
              {% endif %}
            </ul>

            <div class="tab-content mb-4" id="miTabContent">
              {% if plots.mutual_information_plot %}
              <div class="tab-pane fade show active" id="miPlotTarget" role="tabpanel">
                <div class="plot-container mt-2" style="max-height:fit-content;overflow:scroll;">
                  <figure role="img" aria-label="Mutual information ranking bar chart">
                    {{ plots.mutual_information_plot | safe }}
                  </figure>
                </div>
              </div>
              {% endif %}

              {% if plots.mutual_information %}
              <div class="tab-pane fade {% if not plots.mutual_information_plot %}show active{% endif %}"
                   id="miTableTarget" role="tabpanel">
                <div class="table-responsive mt-3">
                  <table class="table table-sm table-striped w-100 dt-table" id="tblMI">
                    <thead>
                    <tr>
                      <th>Feature</th>
                      <th>MI Score</th>
                      <th>Relative Strength</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set max_mi = plots.mutual_information.values() | map(attribute='value') | max %}
                    {% for feature, info in plots.mutual_information.items() | sort(attribute='1.value', reverse=true) %}
                    {% set pct = ((info.value / max_mi) * 100) | round(1) if max_mi > 0 else 0 %}
                    <tr>
                      <td class="font-monospace">{{ feature }}</td>
                      <td class="strength-cell" data-order="{{ info.value }}">
                        <strong>{{ "%.4f"|format(info.value) }}</strong>
                        <div class="strength-bar">
                          <div class="strength-bar-fill bg-primary" style="width:{{ pct }}%"></div>
                        </div>
                      </td>
                      <td>{{ pct }}%</td>
                    </tr>
                    {% endfor %}
                    </tbody>
                  </table>
                </div>
              </div>
              {% endif %}

              {% if plots.mi_relationship_plots %}
              <div class="tab-pane fade" id="miRelTarget" role="tabpanel">
                <p class="text-muted mt-3 mb-2" style="font-size:.85em;">
                  Pairwise plots for top {{ plots.mi_relationship_plots | length }} features by MI score.
                  Plot type adapts to column types automatically.
                </p>
                <div class="row mt-2">
                  {% for item in plots.mi_relationship_plots %}
                  <div class="col-12 mb-4">
                    <div class="d-flex align-items-center mb-1">
                      <span class="font-monospace fw-bold me-2">{{ item.feature }}</span>
                      <span class="badge bg-secondary" style="font-size:.75em;">MI = {{ "%.4f"|format(item.value) }}</span>
                    </div>
                    <div class="plot-container" style="max-height:fit-content;overflow:scroll;">
                      <figure role="img" aria-label="Relationship plot: {{ item.feature }} vs target">
                        {{ item.plot | safe }}
                      </figure>
                    </div>
                  </div>
                  {% endfor %}
                </div>
              </div>
              {% endif %}
            </div>{# /miTabContent #}
            {% endif %}{# /MI block #}

            {# ── Class Balance ── #}
            {% if plots.balance_plot %}
            <h6 class="text-muted fw-normal mb-3" style="font-size:.9rem;">Class Balance</h6>
            <div class="plot-container mb-4" style="max-height:fit-content;overflow:scroll;">
              <figure role="img" aria-label="Class balance distribution of target column">
                {{ plots.balance_plot | safe }}
              </figure>
            </div>
            {% endif %}

          <hr>

          {% endif %}{# /Target section #}

          {# ================================================================
             4) GENERAL STATISTICS
             ================================================================ #}
          <p class="section-heading">General Statistics</p>

          <h6 class="text-muted fw-normal mb-2" style="font-size:.9rem;">Boxplot</h6>
          <div class="plot-container mb-5" style="max-height:fit-content;overflow:scroll;">
            <figure role="img" aria-label="Boxplot for all numeric columns">
              {{ plots.boxplot | safe }}
            </figure>
          </div>

          <h6 class="text-muted fw-normal mb-2" style="font-size:.9rem;">Scatter Matrix</h6>
          <div class="plot-container mb-5" style="max-height:fit-content;overflow:scroll;">
            <figure role="img" aria-label="Scatter matrix for all numeric columns">
              {{ plots.scatter_matrix | safe }}
            </figure>
          </div>

        </div>{# /col-12 #}
      </div>{# /row #}
    </div>{# /container #}
  </div>{# /content-wrap #}

  <footer class="py-5 bg-dark d-flex flex-column justify-content-center align-items-center" id="footer">
    <div class="mb-2">
      <a href="https://github.com/BioWarlockBioProfileKit">
        <img src="static/assets/github.svg" alt="BioProfileKit on GitHub" style="filter:brightness(0) invert(1);">
      </a>
    </div>
    <p class="m-0 text-center text-white">Copyright &copy; JLU 2025</p>
  </footer>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="../static/js/scripts.js"></script>

<script>
  /* Colorblind toggle */
  (function () {
    const btn  = document.getElementById('cbToggle');
    const body = document.body;
    function applyTheme(t) {
      body.dataset.cbTheme = t;
      btn.setAttribute('aria-pressed', t === 'colorblind' ? 'true' : 'false');
      btn.textContent = t === 'colorblind' ? 'Standard Mode' : 'Colorblind Mode';
    }
    const stored = localStorage.getItem('cb-theme');
    if (stored === 'colorblind') { applyTheme('colorblind'); }
    btn.addEventListener('click', function () {
      const next = body.dataset.cbTheme === 'colorblind' ? 'internal' : 'colorblind';
      applyTheme(next); localStorage.setItem('cb-theme', next);
    });
  })();
</script>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.3.1/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.3.1/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/responsive/3.0.4/js/dataTables.responsive.min.js"></script>
<script src="https://cdn.datatables.net/responsive/3.0.4/js/responsive.bootstrap5.min.js"></script>

<script>
  /* DataTables – initialise every table with class dt-table */
  $(document).ready(function () {
    $('.dt-table').DataTable({
      responsive: true,
      pageLength: 25,
      language: {
        search: 'Search:',
        lengthMenu: 'Show _MENU_ entries',
        info: 'Showing _START_ to _END_ of _TOTAL_ entries',
      },
      columnDefs: [
        /* strength-cell columns: sort by data-order, display as-is */
        { targets: '.strength-cell', orderDataType: 'dom-data-order' }
      ]
    });
  });

  /* Custom sort type reading data-order attribute */
  $.fn.dataTable.ext.order['dom-data-order'] = function (settings, col) {
    return this.api().column(col, { order: 'index' }).nodes().map(function (td) {
      return parseFloat($(td).data('order')) || 0;
    });
  };
</script>
</body>
</html>
