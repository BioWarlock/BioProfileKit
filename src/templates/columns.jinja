<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"/>
    <meta name="description" content="Overview of Analysis - BioProfileKit"/>
    <meta name="author" content="JLU"/>
    <title>Column Analysis – BioProfileKit</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="static/assets/favicon.ico"/>
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="static/css/bootstrap.css" rel="stylesheet"/>
    <link href="static/css/cb.css" rel="stylesheet"/>

    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.7/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.0/css/responsive.bootstrap5.min.css">
    <script src="https://cdn.plot.ly/plotly-3.5.0.min.js" charset="utf-8"></script>
    <!-- Performance: pre-establish CDN connections while HTML is parsed -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdn.datatables.net" crossorigin>
    <link rel="preconnect" href="https://cdn.plot.ly" crossorigin>
    <link rel="preconnect" href="https://code.jquery.com" crossorigin>
    <style>
        /* content-visibility: auto skips layout+paint for off-screen cards.
           contain-intrinsic-block-size gives the browser an estimated height
           so the scrollbar stays stable. No JS involved — pure CSS. */
        .column-item {
            content-visibility: auto;
            contain-intrinsic-block-size: 80px;
        }
        /* Filter bar quality-flag button variants */
        .cbf-warning  { color:#664d03;background:transparent;border:1px solid #ffc107;border-radius:.25rem; }
        .cbf-warning:hover  { background:rgba(255,193,7,.15);color:#664d03; }
        .cbf-warning.cbf-active  { background:#ffc107!important;color:#000!important;border-color:#ffc107!important; }
        .cbf-danger   { color:#dc3545;background:transparent;border:1px solid #dc3545;border-radius:.25rem; }
        .cbf-danger:hover   { background:rgba(220,53,69,.1); }
        .cbf-danger.cbf-active   { background:#dc3545!important;color:#fff!important;border-color:#dc3545!important; }
        .cbf-secondary{ color:#6c757d;background:transparent;border:1px solid #6c757d;border-radius:.25rem; }
        .cbf-secondary:hover{ background:rgba(108,117,125,.1); }
        .cbf-secondary.cbf-active{ background:#6c757d!important;color:#fff!important;border-color:#6c757d!important; }
        .cbf-info     { color:#0d6efd;background:transparent;border:1px solid #0d6efd;border-radius:.25rem; }
        .cbf-info:hover     { background:rgba(13,110,253,.1); }
        .cbf-info.cbf-active     { background:#0d6efd!important;color:#fff!important;border-color:#0d6efd!important; }
        .cbf-success  { color:#198754;background:transparent;border:1px solid #198754;border-radius:.25rem; }
        .cbf-success:hover  { background:rgba(25,135,84,.1); }
        .cbf-success.cbf-active  { background:#198754!important;color:#fff!important;border-color:#198754!important; }
    </style>
</head>
<body data-cb-theme="internal">
<!-- Responsive navbar-->
<nav class="navbar navbar-expand-lg navbar-cb-dark bg-dark">
    <div class="container px-5">
        <a class="navbar-brand" href="index.html">BioProfileKit</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="index.html">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="numeric_data.html">Analysis Overview</a></li>
                <li class="nav-item"><a class="nav-link active" aria-current="page" href="columns.html">Column Analysis</a></li>
                <li class="nav-item"><a class="nav-link" href="general_statistics.html">Multivariate Statistics</a></li>

            </ul>
        </div>
    </div>
</nav>
<!-- Page Content-->
<div id="page-container">
    <div id="content-wrap">
        <div class="container px-4 px-lg-5 mb-3">
            <!-- Heading Row-->
            <div class="row gx-4 gx-lg-5 align-items-center mt-5 mb-3">
                <div class="col-12">
                    <h1 class="font-weight-light">Column Analysis</h1>
                    <p style="text-align: justify">
                        Get a compact, numerical summary of all analyses carried out. Visualizations and key figures
                        provide a quick overview of key results and developments-ideal for evaluation at a glance.
                    </p>
                </div>
            </div>
            <!-- Content Row-->

            <!-- Toggle All Elements -->
            <div class="row mb-3">
                <div class="d-inline-flex">
                    <button id="expandAllBtn" class="btn btn-cb-outline-primary me-2" type="button" style="min-width: 250px;">
                        Expand all Elements
                    </button>
                    <button id="collapseAllBtn" class="btn btn-cb-outline-primary" type="button" style="min-width: 250px;">
                        Hide all Elements
                    </button>
                </div>
            </div>


            <!-- ── Filter Bar ── -->
            <div class="mb-4">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <input type="search" id="col-search" class="form-control form-control-sm"
                           style="max-width:300px;" placeholder="Search column name…" autocomplete="off">
                    <button id="toggle-filters-btn" type="button"
                            class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                            data-bs-toggle="collapse" data-bs-target="#filter-options"
                            aria-expanded="false" aria-controls="filter-options">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M6 10.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5zm-2-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm-2-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5z"/>
                        </svg>
                        Filters
                        <span id="active-filter-badge" class="badge rounded-pill bg-primary"
                              style="display:none;font-size:.7em;">0</span>
                    </button>
                    <span class="text-muted small">
                        Showing <strong id="filter-count">{{ columns|length }}</strong>
                        of {{ columns|length }} columns
                    </span>
                    <button id="reset-filters" class="btn btn-sm btn-outline-secondary ms-auto"
                            style="display:none;">✕ Reset</button>
                </div>
                <div class="collapse" id="filter-options">
                    <div class="card card-body border-0 bg-light mt-2 py-3">
                        <div class="row g-3 align-items-start">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold mb-1">Data type</label>
                                <div class="d-flex flex-wrap gap-1" id="type-filters">
                                    <button class="btn btn-sm btn-primary active" data-type-filter="all">All</button>
                                    <button class="btn btn-sm btn-outline-primary" data-type-filter="numeric">Numeric</button>
                                    <button class="btn btn-sm btn-outline-primary" data-type-filter="categorical">Categorical</button>
                                    <button class="btn btn-sm btn-outline-primary" data-type-filter="sequence">Sequence</button>
                                    <button class="btn btn-sm btn-outline-primary" data-type-filter="bool">Boolean</button>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-semibold mb-0">Quality flags</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted small">Match:</span>
                                        <div class="btn-group btn-group-sm" id="logic-toggle" role="group">
                                            <button type="button" class="btn btn-outline-secondary" data-logic="and"
                                                    title="Show only columns matching ALL selected flags">ALL</button>
                                            <button type="button" class="btn btn-secondary active" data-logic="or"
                                                    title="Show columns matching ANY selected flag">ANY</button>
                                        </div>
                                    </div>
                                </div>
                                <!-- Quick shortcut: show all columns that carry at least one alert badge -->
                                <div class="mb-2">
                                    <button class="btn btn-sm btn-outline-danger" id="any-alert-btn"
                                            title="Show only columns that have at least one quality alert (any severity)">
                                        ⚠ Any Alert
                                    </button>
                                </div>
                                <div class="d-flex flex-wrap gap-1" id="quality-filters">
                                    <!-- General / structural -->
                                    <button class="btn btn-sm cbf-secondary" data-quality="missing"       title="Has any missing values">Missing</button>
                                    <button class="btn btn-sm cbf-danger"    data-quality="constant"      title="All values identical — zero variance">Constant</button>
                                    <button class="btn btn-sm cbf-secondary" data-quality="correlation"   title="Correlated with another column">Correlated</button>
                                    <!-- Numeric -->
                                    <button class="btn btn-sm cbf-danger"    data-quality="infinity"      title="Contains Inf/-Inf — will crash most ML pipelines">∞ Infinity</button>
                                    <button class="btn btn-sm cbf-warning"   data-quality="sparse"        title="≥ 50% zero values — sparse feature">Sparse</button>
                                    <button class="btn btn-sm cbf-warning"   data-quality="outliers"      title="≥ 5% outliers detected (adjusted IQR)">Outliers</button>
                                    <!-- Categorical -->
                                    <button class="btn btn-sm cbf-warning"   data-quality="imbalanced"    title="Class imbalance ratio > 3">Imbalanced</button>
                                    <button class="btn btn-sm cbf-danger"    data-quality="nzv"           title="Near-zero variance — top category ≥ 95%">NZV</button>
                                    <button class="btn btn-sm cbf-secondary" data-quality="rare"          title="Has rare categories (< 1% frequency)">Rare Cat.</button>
                                    <button class="btn btn-sm cbf-warning"   data-quality="mixedvalues"   title="Column contains mixed numeric and non-numeric values">Mixed Values</button>
                                    <!-- Sequence -->
                                    <button class="btn btn-sm cbf-danger"    data-quality="invalidseqs"   title="Contains invalid / unparseable sequences">Invalid Seq.</button>
                                    <button class="btn btn-sm cbf-warning"   data-quality="ambiguousbases" title="Mean ambiguous base ratio (N) > 0 — possible low sequencing quality">Ambiguous Bases</button>
                                    <button class="btn btn-sm cbf-warning"   data-quality="rcduplicates"  title="Reverse-complement duplicate sequences detected">RC Duplicates</button>
                                    <button class="btn btn-sm cbf-warning"   data-quality="lowcomplexity" title="Low sequence complexity (Shannon entropy < 50%) — possible repeats or poly-A tails">Low Complexity</button>
                                    <!-- Biological metadata -->
                                    <button class="btn btn-sm cbf-danger"    data-quality="taxonomyinvalid"    title="Taxonomy identifiers failed validation">Taxonomy Invalid</button>
                                    <button class="btn btn-sm cbf-danger"    data-quality="annotationinvalid"  title="Functional annotation failed controlled vocabulary check">Annotation Invalid</button>
                                    <!-- Data anomalies -->
                                    <button class="btn btn-sm cbf-warning"   data-quality="dataanomalies" title="Suspect or anomalous values detected in this column">Data Anomalies</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% set items_per_page = 20 %}
            {% set total_pages = (columns|length / items_per_page)|round(0, 'ceil')|int %}

            {% if total_pages > 1 %}
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                <span class="text-muted me-3">
                    Showing <span id="current-range">1-{{ [items_per_page, columns|length]|min }}</span>
                    of {{ columns|length }} columns
                </span>
                            </div>
                            <nav aria-label="Column pagination">
                                <ul class="pagination pagination-sm mb-0" id="column-pagination">
                                    <!-- Pagination is generated via JavaScript -->
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            {% endif %}

            <!-- Toggle Elements Container -->
            <div id="columns-container">
                {% for col in columns %}
                    {# fns = filter namespace — separate from badge ns #}
                    {% set fns = namespace(has_inf='no',is_sparse='no',has_outliers='no',imbalanced='no',nzv='no',rare='no',ambiguous_bases='no',rc_duplicates='no',low_complexity='no',mixed_values='no',data_anomalies='no',taxonomy_invalid='no',annotation_invalid='no') %}
                    {% for ov in overview %}{% if ov.name == col.name %}
                        {% set _n = col.number if col.number and col.number > 0 else 1 %}
                        {% if ov.infinity is defined and ov.infinity > 0 %}{% set fns.has_inf = 'yes' %}{% endif %}
                        {% if ov.zero_count is defined and (ov.zero_count / _n) >= 0.5 %}{% set fns.is_sparse = 'yes' %}{% endif %}
                        {% if ov.outliers and ((ov.outliers.n_lower_iqr + ov.outliers.n_upper_iqr) / _n) >= 0.05 %}{% set fns.has_outliers = 'yes' %}{% endif %}
                    {% endif %}{% endfor %}
                    {% for cat in categorical %}{% if cat.name == col.name %}
                        {% if cat.cib_ratio is defined and cat.cib_ratio > 3 %}{% set fns.imbalanced = 'yes' %}{% endif %}
                        {% if cat.top_1_coverage is defined and cat.top_1_coverage >= 0.95 %}{% set fns.nzv = 'yes' %}{% endif %}
                        {% if cat.rare_categories is defined and cat.rare_categories > 0 %}{% set fns.rare = 'yes' %}{% endif %}
                    {% endif %}{% endfor %}
                    {% if col.sequence != 'None' and col.dna_rna_data %}
                        {% if col.dna_rna_data.ambiguous_base_ratio is defined and col.dna_rna_data.ambiguous_base_ratio.mean > 0 %}{% set fns.ambiguous_bases = 'yes' %}{% endif %}
                        {% if col.dna_rna_data.reverse_complement_ratio is defined and col.dna_rna_data.reverse_complement_ratio > 0 %}{% set fns.rc_duplicates = 'yes' %}{% endif %}
                        {% if col.dna_rna_data.low_complexity is defined and col.dna_rna_data.low_complexity.mean < 50 %}{% set fns.low_complexity = 'yes' %}{% endif %}
                    {% endif %}
                    {% if col.sequence != 'None' and col.protein_data %}
                        {% if col.protein_data.low_complexity is defined and col.protein_data.low_complexity.mean < 50 %}{% set fns.low_complexity = 'yes' %}{% endif %}
                        {% if col.protein_data.stop_codon_ratio is defined and col.protein_data.stop_codon_ratio > 0 %}{% set fns.data_anomalies = 'yes' %}{% endif %}
                    {% endif %}
                    {% if col.measurement_data and col.measurement_data.with_measurement %}{% set fns.mixed_values = 'yes' %}{% endif %}
                    {% if col.suspect_values is not none and not (col.invalid_seqs and col.invalid_seqs|length > 0) %}{% set fns.data_anomalies = 'yes' %}{% endif %}
                    {% if col.taxonomy and col.taxonomy.is_taxonomy and col.taxonomy.taxonomy is not string %}{% set fns.taxonomy_invalid = 'yes' %}{% endif %}
                    {% if col.annotation and col.annotation.is_annotation and col.taxonomy.valid_annotation is not string %}{% set fns.annotation_invalid = 'yes' %}{% endif %}
                    <div class="card row mt-3 column-item" data-index="{{ loop.index0 }}"
                         data-name="{{ col.name | lower }}"
                         data-type="{{ col.type }}"
                         data-sequence="{{ col.sequence }}"
                         data-missing="{{ 'yes' if col.missing_per and col.missing_per > 0 else 'no' }}"
                         data-constant="{{ 'yes' if col.unique == 1 else 'no' }}"
                         data-correlation="{{ 'yes' if col.correlation else 'no' }}"
                         data-infinity="{{ fns.has_inf }}"
                         data-sparse="{{ fns.is_sparse }}"
                         data-outliers="{{ fns.has_outliers }}"
                         data-imbalanced="{{ fns.imbalanced }}"
                         data-nzv="{{ fns.nzv }}"
                         data-rare="{{ fns.rare }}"
                         data-invalidseqs="{{ 'yes' if col.invalid_seqs and col.invalid_seqs|length > 0 else 'no' }}"
                         data-ambiguousbases="{{ fns.ambiguous_bases }}"
                         data-rcduplicates="{{ fns.rc_duplicates }}"
                         data-lowcomplexity="{{ fns.low_complexity }}"
                         data-mixedvalues="{{ fns.mixed_values }}"
                         data-dataanomalies="{{ fns.data_anomalies }}"
                         data-taxonomyinvalid="{{ fns.taxonomy_invalid }}"
                         data-annotationinvalid="{{ fns.annotation_invalid }}"
                         style="display: {% if loop.index0 < items_per_page %}block{% else %}none{% endif %};">
                        <div class="card-header d-inline-flex gap-1 mb-2">
                            <button class="btn btn-cb-outline-primary" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#multiCollapse{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                    aria-expanded="false"
                                    aria-controls="multiCollapse{{ col.name | replace(' ', '') |  replace('.', '_') | replace('#', '') |capitalize }}" style="min-width: 200px;">
                                {{ col.name.replace('_', ' ').title() }}
                            </button>
                            <div class="m-2 d-flex">
                                {% if col.taxonomy and col.taxonomy.is_taxonomy and col.taxonomy.taxonomy is not string %}
                                    <span class="badge bg-danger me-2">Taxonomy invalid</span>
                                {% endif %}
                                {% if col.annotation and col.annotation.is_annotation and col.taxonomy.valid_annotation is not string %}
                                    <span class="badge bg-danger me-2">Annotation invalid</span>
                                {% endif %}
                                {% if col.unique == 1 %}
                                    <span class="badge bg-danger me-2">Constant</span>
                                {% endif %}
                                {% if col.missing_per == 100 %}
                                    <span class="badge bg-danger me-2">Empty Column</span>
                                {% elif col.missing_per > 15 %}
                                    <span class="badge bg-danger me-2">Missing</span>
                                {% elif 5 < col.missing_per < 15 %}
                                    <span class="badge bg-warning me-2">Missing</span>
                                {% elif 0.1 < col.missing_per < 5 %}
                                    <span class="badge text-bg-light me-2">Missing</span>
                                {% endif %}
                                {% if col.sequence != 'None' %}
                                    <span class="badge bg-success me-2">Sequence</span>
                                {% elif col.measurement_data %}
                                    <span class="badge me-2" style="background-color:#8F8F8F;">Unit</span>
                                {% elif col.type == 'str'%}
                                    <span class="badge bg-dark me-2">Object</span>
                                {% elif col.type == 'bool'%}
                                    <span class="badge bg-dark me-2">Object</span>
                                {% elif col.type == 'object'%}
                                    <span class="badge bg-dark me-2">Object</span>
                                {% elif col.type == 'int64' or 'float64' %}
                                    <span class="badge bg-primary me-2">Number</span>
                                {% endif %}
                                {% if col.correlation %}
                                    {% set ns = namespace(has_low=false, has_moderate=false, has_high=false) %}
                                      {% for corr in col.correlation %}
                                        {% if corr.1 >= 0.7 or corr.1 <= -0.7 %}
                                            {% set ns.has_high = true %}
                                        {% elif corr.1 >= 0.5 or corr.1 <= -0.5 %}
                                            {% set ns.has_moderate = true %}
                                        {% else %}
                                            {% set ns.has_low = true %}
                                        {% endif %}
                                    {% endfor %}
                                    {% if ns.has_low %}
                                        <span class="badge bg-success me-2">Low Correlation</span>
                                    {% endif %}
                                    {% if ns.has_moderate %}
                                        <span class="badge bg-warning me-2">Moderate Correlation</span>
                                    {% endif %}
                                    {% if ns.has_high %}
                                        <span class="badge bg-danger me-2">High Correlation</span>
                                    {% endif %}
                                {% endif %}
                                {% if col.monotonicity %}
                                    <span class="badge bg-secondary me-2"
                                          title="Values are strictly monotonically increasing or decreasing — may indicate an index or time-ordered column">
                                        Monotonic
                                    </span>
                                {% endif %}

                                <!-- TODO: Add missing badges - Skewness, Duplicates, Diff Sequence Length, Biological Naming, Diff Units -->
                                {# ── DNA/RNA quality badges ── #}
                                {% if col.sequence != 'None' and col.dna_rna_data %}
                                    {# Ambiguous Bases (N) #}
                                    {% if col.dna_rna_data.ambiguous_base_ratio is defined and col.dna_rna_data.ambiguous_base_ratio.mean > 0 %}
                                        {% set amb_mean = col.dna_rna_data.ambiguous_base_ratio.mean %}
                                        {% if amb_mean >= 5 %}
                                            <span class="badge bg-danger me-2"
                                                  title="Mean {{ amb_mean }}% ambiguous bases (N) — may indicate poor sequencing quality">
                                                Ambiguous Bases ({{ amb_mean }}%)
                                            </span>
                                        {% else %}
                                            <span class="badge bg-warning text-dark me-2"
                                                  title="Mean {{ amb_mean }}% ambiguous bases (N) detected">
                                                Ambiguous Bases ({{ amb_mean }}%)
                                            </span>
                                        {% endif %}
                                    {% endif %}
                                    {# Reverse Complement Duplicates #}
                                    {% if col.dna_rna_data.reverse_complement_ratio is defined and col.dna_rna_data.reverse_complement_ratio > 0 %}
                                        {% set rc_pct = col.dna_rna_data.reverse_complement_ratio %}
                                        {% if rc_pct >= 10 %}
                                            <span class="badge bg-danger me-2"
                                                  title="{{ rc_pct }}% of sequences have a reverse-complement duplicate — possible library preparation artefact">
                                                RC Duplicates ({{ rc_pct }}%)
                                            </span>
                                        {% elif rc_pct >= 1 %}
                                            <span class="badge bg-warning text-dark me-2"
                                                  title="{{ rc_pct }}% of sequences have a reverse-complement duplicate">
                                                RC Duplicates ({{ rc_pct }}%)
                                            </span>
                                        {% endif %}
                                    {% endif %}
                                    {# Low Complexity #}
                                    {% if col.dna_rna_data.low_complexity is defined and col.dna_rna_data.low_complexity.mean < 50 %}
                                        <span class="badge bg-warning text-dark me-2"
                                              title="Mean Shannon entropy {{ col.dna_rna_data.low_complexity.mean }}% — possible poly-A tails or repetitive regions">
                                            Low Complexity
                                        </span>
                                    {% endif %}
                                {% endif %}
                                {# ── Categorical quality badges ── #}
                                {% if col.type in ['object', 'bool', 'str'] %}
                                    {% for cat in categorical %}{% if cat.name == col.name %}
                                        {# Class Imbalance Ratio #}
                                        {% if cat.cib_ratio is defined %}
                                            {% if cat.cib_ratio > 10 %}
                                                <span class="badge bg-danger me-2"
                                                      title="Class Imbalance Ratio {{ cat.cib_ratio | round(1) }}x — most frequent category dominates strongly">
                                                    Imbalanced ({{ cat.cib_ratio | round(1) }}×)
                                                </span>
                                            {% elif cat.cib_ratio > 3 %}
                                                <span class="badge bg-warning text-dark me-2"
                                                      title="Class Imbalance Ratio {{ cat.cib_ratio | round(1) }}x — notable frequency skew between categories">
                                                    Imbalanced ({{ cat.cib_ratio | round(1) }}×)
                                                </span>
                                            {% endif %}
                                        {% endif %}
                                        {# Rare Categories #}
                                        {% if cat.rare_categories is defined and cat.rare_categories > 0 %}
                                            <span class="badge bg-secondary me-2"
                                                  title="{{ cat.rare_categories }} category/categories with < 1% frequency — may cause issues in ML splits">
                                                {{ cat.rare_categories }} Rare
                                                {% if cat.rare_categories == 1 %}Category{% else %}Categories{% endif %}
                                            </span>
                                        {% endif %}
                                        {# Near-Zero Variance — single category covers almost everything #}
                                        {% if cat.top_1_coverage is defined and cat.top_1_coverage >= 0.95 %}
                                            <span class="badge bg-danger me-2"
                                                  title="Top category covers {{ (cat.top_1_coverage * 100) | round(1) }}% of values — near-zero variance">
                                                NZV ({{ (cat.top_1_coverage * 100) | round(1) }}%)
                                            </span>
                                        {% endif %}
                                    {% endif %}{% endfor %}
                                {% endif %}
                                {# ── Numeric quality badges ── #}
                                {% if col.type in ['int64', 'float64'] %}
                                    {% for ov in overview %}{% if ov.name == col.name %}
                                        {% set n_total = col.number if col.number and col.number > 0 else 1 %}
                                        {# Infinity — pipeline-critical #}
                                        {% if ov.infinity is defined and ov.infinity > 0 %}
                                            <span class="badge bg-danger me-2"
                                                  title="{{ ov.infinity }} Inf / -Inf value(s) — will crash most ML pipelines">
                                                ∞ Infinity ({{ ov.infinity }})
                                            </span>
                                        {% endif %}
                                        {# Sparse feature #}
                                        {% if ov.zero_count is defined %}
                                            {% set zero_pct = (ov.zero_count / n_total * 100) | round(1) %}
                                            {% if zero_pct >= 80 %}
                                                <span class="badge bg-danger me-2"
                                                      title="{{ zero_pct }}% of values are zero — highly sparse feature">
                                                    Sparse ({{ zero_pct }}%)
                                                </span>
                                            {% elif zero_pct >= 50 %}
                                                <span class="badge bg-warning text-dark me-2"
                                                      title="{{ zero_pct }}% of values are zero">
                                                    Sparse ({{ zero_pct }}%)
                                                </span>
                                            {% endif %}
                                        {% endif %}
                                        {# Outliers (Adj. IQR) #}
                                        {% if ov.outliers %}
                                            {% set n_out = ov.outliers.n_lower_iqr + ov.outliers.n_upper_iqr %}
                                            {% set out_pct = (n_out / n_total * 100) | round(1) %}
                                            {% if out_pct >= 10 %}
                                                <span class="badge bg-danger me-2"
                                                      title="{{ n_out }} outlier(s) outside adjusted IQR bounds ({{ out_pct }}%)">
                                                    Outliers ({{ out_pct }}%)
                                                </span>
                                            {% elif out_pct >= 5 %}
                                                <span class="badge bg-warning text-dark me-2"
                                                      title="{{ n_out }} outlier(s) outside adjusted IQR bounds ({{ out_pct }}%)">
                                                    Outliers ({{ out_pct }}%)
                                                </span>
                                            {% endif %}
                                        {% endif %}
                                    {% endif %}{% endfor %}
                                {% endif %}
                                {% if col.measurement_data %}
                                    {% if col.measurement_data.with_measurement %}
                                        <span class="badge bg-warning me-2">Mixed Values</span>
                                    {% endif %}
                                {% endif %}
                                {% if col.suspect_values is not none and not (col.invalid_seqs and col.invalid_seqs|length > 0) %}
                                    <span class="badge bg-warning me-2">Data Anomalies</span>
                                {% endif %}
                                {% if col.invalid_seqs and col.invalid_seqs|length > 0 %}
                                    <span class="badge me-2" style="background-color: #f8d7da; color: #c6081a; border: 1px solid #c6081a;">Invalid Sequences</span>                                {% endif %}
                            </div>
                        </div>
                        <div class="card-body collapse multi-collapse "
                             id="multiCollapse{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                            <div class="card card-body d-flex justify-content-between align-items-start mb-2">
                                <div class="row w-100">
                                    <!-- Left column: text information -->
                                    <div class="col-md-6">
                                        <strong>Column:</strong> {{ col.name }}<br>
                                        <strong>Number of Values:</strong> {{ col.number }}<br>
                                        <strong>Number of Unique:</strong> {{ col.unique }}<br>
                                        <strong>Number of Missing:</strong> {{ col.missing }} ({{ col.missing_per }}%)<br>
                                        <strong>Cardinality Dimension Ratio:</strong> {{ col.cardinality_dimension_ratio }}<br>
                                        {% if col.type not in ('object', 'str') %}
                                            <!-- TODO: Show number type only for numeric columns, or for all dtypes? -->
                                            <strong>Number type:</strong> {{ col.type }}<br>
                                        {% endif %}
                                        {% if col.mixed_types is not none %}
                                            <strong>Mixed Types:</strong> {{ col.mixed_types[0] }}<br>
                                        {% endif %}
                                        {% if col.sequence != 'None' %}
                                            <strong>Sequence type:</strong> {{ col.sequence }}<br>
                                        {% endif %}
                                        {% if col.taxonomy and col.taxonomy.is_taxonomy %}
                                            {% if col.taxonomy.taxonomy is string %}
                                                <strong>Taxonomy:</strong>
                                                <span class="text-success">Valid</span><br>
                                            {% else %}
                                                <strong>Taxonomy:</strong>
                                                <span class="text-danger">{{ col.taxonomy.taxonomy | length }} invalid entr{{ 'y' if col.taxonomy.taxonomy | length == 1 else 'ies' }}</span><br>
                                            {% endif %}
                                            {% if col.taxonomy.is_mixed %}
                                                <strong>Rank:</strong> <span class="text-warning">Mixed</span><br>
                                            {% elif col.taxonomy.rank_distribution %}
                                                {% set dominant = col.taxonomy.rank_distribution | dictsort(by='value', reverse=true) | first %}
                                                <strong>Rank:</strong> {{ dominant[0] }} ({{ (dominant[1] * 100) | round(1) }}%)<br>
                                            {% endif %}
                                            {% if col.taxonomy.outdated_names %}
                                                <strong>Outdated names:</strong> {{ col.taxonomy.outdated_names | length }}<br>
                                            {% endif %}
                                        {% elif col.taxonomy is defined and col.taxonomy is none %}
                                            <strong>Taxonomy:</strong>
                                            <span class="text-muted">Not checked
                                                <small>(run with <code>--tax</code> to enable)</small>
                                            </span><br>
                                        {% endif %}
                                        {% if col.annotation and col.annotation.is_annotation %}
                                            {% if col.annotation.valid_annotation is string %}
                                                <strong>Functional Annotation:</strong> {{ col.annotation.valid_annotation }}<br>
                                            {% else %}
                                                <strong>Functional Annotation:</strong> Invalid<br>
                                            {% endif %}
                                        {% endif %}
                                        {% if col.correlation %}
                                            <strong>Correlates with:</strong><br>
                                            {% for corr in col.correlation %}
                                                &emsp;
                                                <a href="#multiCollapse{{ corr.0.replace(' ', '') | capitalize }}"
                                                   class="cb-pink-link">
                                                    {{ corr.0.replace('_', ' ') | capitalize }}
                                                </a>: {{ corr.1 }}<br>
                                            {% endfor %}
                                        {% endif %}
                                        {% if col.monotonicity %}
                                            <strong>Monotonicity:</strong>
                                            <span class="text-muted">strictly ordered (↑ or ↓) — consider excluding from association analysis</span><br>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="row w-100">
                                    {% if col.describe_plot %}
                                        <div class="plot-container mb-4 w-100" style="max-height: fit-content; overflow-x: auto;">
                                            <figure role="img" aria-label="Overview plot for column {{ col.name }}" style="width:100%;">
                                                {{ col.describe_plot | safe }}
                                            </figure>
                                        </div>
                                    {% endif %}
                                </div>

                                {% if col.sequence == 'None' and col.missing_per < 100 %}
                                    <ul class="nav nav-tabs" id="objectTab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link active" id="object-stats-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                    data-bs-toggle="tab" data-bs-target="#objectStats{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                    type="button" role="tab">Top 20 Occurrences</button>
                                        </li>
                                        {% if col.measurement_data %}
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" id="unit-stats-tab{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                        data-bs-toggle="tab" data-bs-target="#unitStats{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                        type="button" role="tab">Unit Statistics</button>
                                            </li>
                                        {% endif %}
                                        {% if col.suspect_values is not none %}
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" id="suspect-stats-tab{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                        data-bs-toggle="tab" data-bs-target="#suspectStats{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                        type="button" role="tab">Data Anomalies</button>
                                            </li>
                                        {% endif %}
                                        {% if col.type not in ['object', 'bool', 'str'] and col.type in ['int64', 'float64'] %}
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" id="number-stats-tab{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                        data-bs-toggle="tab" data-bs-target="#numberStats{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                        type="button" role="tab">General Overview</button>
                                            </li>
                                        {% endif %}
                                        {% if col.type in ['object', 'bool', 'str'] and col.type not in ['int64', 'float64'] %}
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" id="cat-stats-tab{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                        data-bs-toggle="tab" data-bs-target="#catStats{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                        type="button" role="tab">Categorical Statistics</button>
                                            </li>
                                        {% endif %}

                                        {% if col.taxonomy is defined and col.taxonomy is not none and col.taxonomy.is_taxonomy %}
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" id="tax-stats-tab{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                        data-bs-toggle="tab" data-bs-target="#taxStats{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                        type="button" role="tab">
                                                    Taxonomy
                                                    {% if col.taxonomy.taxonomy is not string %}
                                                        <span class="badge bg-danger ms-1" style="font-size:.7em;">Invalid</span>
                                                    {% else %}
                                                        <span class="badge bg-success ms-1" style="font-size:.7em;">Valid</span>
                                                    {% endif %}
                                                </button>
                                            </li>
                                        {% elif col.taxonomy is defined and col.taxonomy is none %}
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link disabled" type="button" role="tab"
                                                        title="Taxonomy analysis not enabled — run with --tax">
                                                    Taxonomy
                                                    <span class="badge bg-secondary ms-1" style="font-size:.7em;">–</span>
                                                </button>
                                            </li>
                                        {% endif %}
                                    </ul>

                                    <div class="row w-100 tab-content" id="objectTabContent{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                        <!-- Object Stats Tab -->
                                        <div class="tab-pane fade show active" id="objectStats{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel"
                                             aria-labelledby="object-stats-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                            <div class="table-responsive mt-3" style="max-height: 400px; overflow-y: auto;">
                                                <table class="table table-sm table-striped w-100" style="min-width: 600px;">
                                                    <thead class="sticky-top bg-light">
                                                    <tr>
                                                        <th>Value</th>
                                                        <th>Count</th>
                                                        <th>Frequency</th>
                                                    </tr>
                                                    </thead>
                                                    <tbody>
                                                    {% for cat in categorical %}
                                                        {% if col.name == cat.name %}
                                                            {% for key, value in cat.frequencies.items() %}
                                                                <tr>
                                                                    <td>{{ key }}</td>
                                                                    <td>{{ cat.value_counts[key] }}</td>
                                                                    <td>{{ value }}</td>
                                                                </tr>
                                                            {% endfor %}
                                                        {% endif %}
                                                    {% endfor %}
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <!-- Unit Stats Tab -->
                                        {% if col.measurement_data %}
                                            <div class="tab-pane fade" id="unitStats{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel"
                                                 aria-labelledby="unit-stats-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                <div class="table-responsive mt-3" style="max-height: 400px; overflow-y: auto;">
                                                    <table class="table table-sm table-striped w-100" style="min-width: 500px;">
                                                        <thead class="sticky-top bg-light">
                                                        <tr>
                                                            <th>Unit</th>
                                                            <th>Count</th>
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        {% for unit, count in col.measurement_data.unit_counts.items() %}
                                                            <tr>
                                                                <td>{{ unit }}</td>
                                                                <td>{{ count }}</td>
                                                            </tr>
                                                        {% endfor %}
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        {% endif %}
                                        <!-- Suspect Value Tab -->
                                        {% if col.suspect_values is not none %}
                                            <div class="tab-pane fade" id="suspectStats{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel"
                                                 aria-labelledby="suspect-stats-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                <div class="alert alert-warning mt-3">
                                                    <strong>Note:</strong> {{ col.suspect_values|length }} suspect value(s) detected. These values appear to be of a different type than the majority of this column.
                                                </div>
                                                    <div class="table-responsive mt-3" style="max-height: 400px; overflow-y: auto;">
                                                        <table class="table table-sm table-striped w-100" style="min-width: 500px;">
                                                            <thead class="sticky-top bg-light">
                                                        <tr>
                                                            <th>Index</th>
                                                            <th>Value</th>
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        {% for idx, val in col.suspect_values.items() %}
                                                            <tr>
                                                                <td>{{ idx }}</td>
                                                                <td>{{ val }}</td>
                                                            </tr>
                                                        {% endfor %}
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        {% endif %}
                                        <!-- Taxonomy Tab -->
                                        {% if col.taxonomy is defined and col.taxonomy is not none and col.taxonomy.is_taxonomy %}
                                            {% set tax = col.taxonomy %}
                                            {% set cid = col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize %}
                                            <div class="tab-pane fade" id="taxStats{{ cid }}" role="tabpanel"
                                                 aria-labelledby="tax-stats-tab{{ cid }}">
                                                <div class="mt-3">

                                                    {# ── Status banner ── #}
                                                    {% if tax.taxonomy is string %}
                                                        <div class="alert alert-success d-flex align-items-center gap-2 py-2">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg>
                                                            All taxonomy entries validated successfully.
                                                        </div>
                                                    {% else %}
                                                        <div class="alert alert-danger d-flex align-items-center gap-2 py-2">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/></svg>
                                                            <span>{{ tax.taxonomy | length }} invalid taxonomy entr{{ 'y' if tax.taxonomy | length == 1 else 'ies' }} detected.</span>
                                                        </div>
                                                    {% endif %}

                                                    {# ── Mixed rank warning ── #}
                                                    {% if tax.is_mixed %}
                                                        <div class="alert alert-warning py-2 small">
                                                            <strong>Mixed Ranks:</strong> This column contains taxonomy entries from multiple ranks. Consider splitting or filtering by rank before downstream analysis.
                                                        </div>
                                                    {% endif %}

                                                    {# ── Sub-tabs ── #}
                                                    <ul class="nav nav-tabs mt-2" id="taxSubTab{{ cid }}" role="tablist">
                                                        <li class="nav-item" role="presentation">
                                                            <button class="nav-link active" data-bs-toggle="tab"
                                                                    data-bs-target="#taxRank{{ cid }}" type="button" role="tab">
                                                                Rank Distribution
                                                            </button>
                                                        </li>
                                                        {% if tax.taxonomy is not string %}
                                                            <li class="nav-item" role="presentation">
                                                                <button class="nav-link" data-bs-toggle="tab"
                                                                        data-bs-target="#taxInvalid{{ cid }}" type="button" role="tab">
                                                                    Invalid Entries
                                                                    <span class="badge bg-danger ms-1" style="font-size:.7em;">{{ tax.taxonomy | length }}</span>
                                                                </button>
                                                            </li>
                                                        {% endif %}
                                                        {% if tax.outdated_names %}
                                                            <li class="nav-item" role="presentation">
                                                                <button class="nav-link" data-bs-toggle="tab"
                                                                        data-bs-target="#taxOutdated{{ cid }}" type="button" role="tab">
                                                                    Outdated Names
                                                                    <span class="badge bg-warning text-dark ms-1" style="font-size:.7em;">{{ tax.outdated_names | length }}</span>
                                                                </button>
                                                            </li>
                                                        {% endif %}
                                                        {% if tax.taxid %}
                                                            <li class="nav-item" role="presentation">
                                                                <button class="nav-link" data-bs-toggle="tab"
                                                                        data-bs-target="#taxIds{{ cid }}" type="button" role="tab">
                                                                    Tax IDs
                                                                    {% if tax.taxid is not string %}
                                                                        <span class="badge bg-danger ms-1" style="font-size:.7em;">{{ tax.taxid | length }} invalid</span>
                                                                    {% else %}
                                                                        <span class="badge bg-success ms-1" style="font-size:.7em;">Valid</span>
                                                                    {% endif %}
                                                                </button>
                                                            </li>
                                                        {% endif %}
                                                    </ul>

                                                    <div class="tab-content mt-2" id="taxSubContent{{ cid }}">

                                                        {# ── Rank Distribution ── #}
                                                        <div class="tab-pane fade show active" id="taxRank{{ cid }}" role="tabpanel">
                                                            {% if tax.rank_distribution %}
                                                                <div class="table-responsive mt-2" style="max-height: 350px; overflow-y: auto;">
                                                                    <table class="table table-sm table-striped w-100">
                                                                        <thead class="sticky-top bg-light">
                                                                        <tr>
                                                                            <th>Rank</th>
                                                                            <th>Frequency</th>
                                                                            <th style="min-width:180px;">Distribution</th>
                                                                        </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                        {% for rank, freq in tax.rank_distribution.items() | sort(attribute='1', reverse=true) %}
                                                                            {% set pct = (freq * 100) | round(1) %}
                                                                            <tr>
                                                                                <td>{{ rank if rank else '—' }}</td>
                                                                                <td>{{ pct }}%</td>
                                                                                <td>
                                                                                    <div class="progress" style="height:14px;">
                                                                                        <div class="progress-bar {% if pct >= 80 %}bg-success{% elif pct >= 40 %}bg-primary{% else %}bg-secondary{% endif %}"
                                                                                             role="progressbar" style="width:{{ pct }}%"
                                                                                             aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100">
                                                                                        </div>
                                                                                    </div>
                                                                                </td>
                                                                            </tr>
                                                                        {% endfor %}
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                                {% if tax.is_mixed %}
                                                                    <p class="text-muted small mt-2">Multiple ranks exceed 5 % — column appears to contain a mixture of taxonomic levels.</p>
                                                                {% endif %}
                                                            {% else %}
                                                                <p class="text-muted mt-3">No rank distribution available.</p>
                                                            {% endif %}
                                                        </div>

                                                        {# ── Invalid Entries ── #}
                                                        {% if tax.taxonomy is not string %}
                                                            <div class="tab-pane fade" id="taxInvalid{{ cid }}" role="tabpanel">
                                                                <div class="alert alert-warning small py-2 mt-2">
                                                                    These entries could not be matched against the NCBI taxonomy database. Check for spelling errors, synonyms, or outdated names.
                                                                </div>
                                                                <div class="table-responsive mt-1" style="max-height: 350px; overflow-y: auto;">
                                                                    <table class="table table-sm table-striped w-100">
                                                                        <thead class="sticky-top bg-light">
                                                                        <tr><th>#</th><th>Entry</th></tr>
                                                                        </thead>
                                                                        <tbody>
                                                                        {% for entry in tax.taxonomy %}
                                                                            <tr>
                                                                                <td class="text-muted">{{ loop.index }}</td>
                                                                                <td>{{ entry }}</td>
                                                                            </tr>
                                                                        {% endfor %}
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        {% endif %}

                                                        {# ── Outdated Names ── #}
                                                        {% if tax.outdated_names %}
                                                            <div class="tab-pane fade" id="taxOutdated{{ cid }}" role="tabpanel">
                                                                <div class="alert alert-warning small py-2 mt-2">
                                                                    These names are recognised but have been replaced by a current scientific name. Consider updating them for consistency.
                                                                </div>
                                                                <div class="table-responsive mt-1" style="max-height: 350px; overflow-y: auto;">
                                                                    <table class="table table-sm table-striped w-100">
                                                                        <thead class="sticky-top bg-light">
                                                                        <tr>
                                                                            <th>Used Name</th>
                                                                            <th>Current Scientific Name</th>
                                                                        </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                        {% for used, current in tax.outdated_names.items() %}
                                                                            <tr>
                                                                                <td class="text-warning-emphasis">{{ used }}</td>
                                                                                <td class="fst-italic">{{ current }}</td>
                                                                            </tr>
                                                                        {% endfor %}
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        {% endif %}

                                                        {# ── Tax IDs ── #}
                                                        {% if tax.taxid %}
                                                            <div class="tab-pane fade" id="taxIds{{ cid }}" role="tabpanel">
                                                                {% if tax.taxid is string %}
                                                                    <div class="alert alert-success small py-2 mt-2">
                                                                        All numeric IDs in this column are valid NCBI taxonomy identifiers.
                                                                    </div>
                                                                {% else %}
                                                                    <div class="alert alert-danger small py-2 mt-2">
                                                                        {{ tax.taxid | length }} ID(s) could not be matched against the NCBI taxonomy database.
                                                                    </div>
                                                                    <div class="table-responsive mt-1" style="max-height: 350px; overflow-y: auto;">
                                                                        <table class="table table-sm table-striped w-100">
                                                                            <thead class="sticky-top bg-light">
                                                                            <tr><th>#</th><th>Invalid Tax ID</th></tr>
                                                                            </thead>
                                                                            <tbody>
                                                                            {% for tid in tax.taxid | sort %}
                                                                                <tr>
                                                                                    <td class="text-muted">{{ loop.index }}</td>
                                                                                    <td>{{ tid }}</td>
                                                                                </tr>
                                                                            {% endfor %}
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                                {% endif %}
                                                            </div>
                                                        {% endif %}

                                                    </div>{# /tab-content #}
                                                </div>
                                            </div>
                                        {% endif %}
                                        <!-- General Overview for numeric columns -->
                                        {% if col.type not in ['object', 'bool', 'str'] and col.type in ['int64', 'float64'] %}
                                            <div class="tab-pane fade" id="numberStats{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel"
                                                 aria-labelledby="number-stats-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                <div class="table-responsive mt-3" style="max-height: 400px; overflow-y: auto;">
                                                    {% for ov in overview %}
                                                        {% if ov.name == col.name %}
                                                        {% set n_total = col.number if col.number and col.number > 0 else 1 %}
                                                        <table class="table table-sm table-striped w-100" style="min-width: 450px;">
                                                            <thead>
                                                            <tr>
                                                                <th style="width:55%">Statistic</th>
                                                                <th>Value</th>
                                                            </tr>
                                                            </thead>
                                                            <tbody>

                                                            {# ── Central Tendency & Dispersion ── #}
                                                            <tr class="table-secondary"><td colspan="2"><strong>Central Tendency &amp; Dispersion</strong></td></tr>
                                                            <tr><td>Minimum</td><td>{{ ov.min }}</td></tr>
                                                            <tr><td>Maximum</td><td>{{ ov.max }}</td></tr>
                                                            <tr><td>Mean</td><td>{{ ov.mean }}</td></tr>
                                                            <tr><td>Median</td><td>{{ ov.median }}</td></tr>
                                                            <tr><td>Mode</td><td>{{ ov.mode }}</td></tr>
                                                            <tr><td>Standard Deviation</td><td>{{ ov.std }}</td></tr>
                                                            <tr><td>Sum</td><td>{{ ov.sum }}</td></tr>
                                                            <tr>
                                                                <td>Quantiles</td>
                                                                <td>Q1: {{ ov.quantiles[0] }}&ensp;|&ensp;Q2: {{ ov.quantiles[1] }}&ensp;|&ensp;Q3: {{ ov.quantiles[2] }}</td>
                                                            </tr>
                                                            <tr>
                                                                <td>IQR <small class="text-muted">(Q3 − Q1, linear interpolation)</small></td>
                                                                <td>{{ (ov.quantiles[2] - ov.quantiles[0]) | round(4) }}</td>
                                                            </tr>
                                                            <tr><td>Median Absolute Deviation</td><td>{{ ov.mad }}</td></tr>
                                                            <tr><td>Coefficient of Variation</td><td>{{ ov.coefficient_of_variation }}</td></tr>

                                                            {# ── Distribution Shape ── #}
                                                            <tr class="table-secondary"><td colspan="2"><strong>Distribution Shape</strong></td></tr>
                                                            <tr>
                                                                <td>Skewness</td>
                                                                <td>
                                                                    {{ ov.skewness }}
                                                                    {% if ov.skewness is not none %}
                                                                        {% set sk = ov.skewness | float %}
                                                                        {% if sk | abs > 1 %}
                                                                            <span class="badge bg-warning text-dark ms-2" title="|skewness| > 1">Highly skewed</span>
                                                                        {% elif sk | abs > 0.5 %}
                                                                            <span class="badge bg-secondary ms-2" title="|skewness| > 0.5">Moderate skew</span>
                                                                        {% endif %}
                                                                    {% endif %}
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td>Kurtosis</td>
                                                                <td>
                                                                    {{ ov.kurtosis }}
                                                                    {% if ov.kurtosis is not none %}
                                                                        {% set kt = ov.kurtosis | float %}
                                                                        {% if kt > 3 %}
                                                                            <span class="badge bg-secondary ms-2" title="Heavy tails relative to normal">Leptokurtic</span>
                                                                        {% elif kt < -1 %}
                                                                            <span class="badge bg-secondary ms-2" title="Light tails relative to normal">Platykurtic</span>
                                                                        {% endif %}
                                                                    {% endif %}
                                                                </td>
                                                            </tr>

                                                            {# ── Data Quality ── #}
                                                            <tr class="table-secondary"><td colspan="2"><strong>Data Quality</strong></td></tr>

                                                            {# Zero count #}
                                                            {% set zero_pct = (ov.zero_count / n_total * 100) | round(1) %}
                                                            <tr>
                                                                <td>Zero Values <small class="text-muted">(sparse feature indicator)</small></td>
                                                                <td>
                                                                    {{ ov.zero_count }} <span class="text-muted">({{ zero_pct }}%)</span>
                                                                    {% if zero_pct >= 80 %}<span class="badge bg-danger ms-2">Highly sparse</span>
                                                                    {% elif zero_pct >= 50 %}<span class="badge bg-warning text-dark ms-2">Sparse</span>
                                                                    {% endif %}
                                                                </td>
                                                            </tr>

                                                            {# Negative count #}
                                                            {% set neg_pct = (ov.negative_count / n_total * 100) | round(1) %}
                                                            <tr>
                                                                <td>Negative Values</td>
                                                                <td>{{ ov.negative_count }} <span class="text-muted">({{ neg_pct }}%)</span></td>
                                                            </tr>

                                                            {# Infinity count #}
                                                            <tr {% if ov.infinity > 0 %}class="table-danger"{% endif %}>
                                                                <td>
                                                                    Infinity Values <small class="text-muted">(Inf / -Inf)</small>
                                                                    {% if ov.infinity > 0 %}
                                                                        <span class="badge bg-danger ms-1">Critical</span>
                                                                    {% endif %}
                                                                </td>
                                                                <td>
                                                                    {{ ov.infinity }}
                                                                    {% if ov.infinity > 0 %}
                                                                        <small class="text-danger ms-2">replace with NaN or clip before use</small>
                                                                    {% endif %}
                                                                </td>
                                                            </tr>

                                                            {# Outliers — only if detect_outliers returned a result #}
                                                            {% if ov.outliers %}
                                                                {% set out = ov.outliers %}
                                                                {% set n_iqr = out.n_lower_iqr + out.n_upper_iqr %}
                                                                {% set n_mz  = out.n_lower_mzscore + out.n_upper_mzscore %}
                                                                {% set n_z   = out.n_lower_zscore  + out.n_upper_zscore %}
                                                                {% set iqr_pct = (n_iqr / n_total * 100) | round(1) %}
                                                                {% set mz_pct  = (n_mz  / n_total * 100) | round(1) %}
                                                                {% set z_pct   = (n_z   / n_total * 100) | round(1) %}

                                                                {# Adjusted IQR (Hubert & Vandervieren, 2008) #}
                                                                <tr {% if iqr_pct >= 5 %}class="table-warning"{% endif %}>
                                                                    <td>
                                                                        Outliers — Adjusted IQR
                                                                        <small class="text-muted d-block">Hubert &amp; Vandervieren (2008); bounds adjusted via Medcouple</small>
                                                                    </td>
                                                                    <td>
                                                                        {{ n_iqr }} <span class="text-muted">({{ iqr_pct }}%)</span>
                                                                        {% if iqr_pct >= 10 %}<span class="badge bg-danger ms-2">High</span>
                                                                        {% elif iqr_pct >= 5 %}<span class="badge bg-warning text-dark ms-2">Moderate</span>
                                                                        {% endif %}
                                                                        <small class="text-muted d-block">
                                                                            ↓ {{ out.n_lower_iqr }} below {{ out.lower_bound }}
                                                                            &ensp;↑ {{ out.n_upper_iqr }} above {{ out.upper_bound }}
                                                                            &ensp;MC: {{ out.medcouple }}
                                                                        </small>
                                                                    </td>
                                                                </tr>

                                                                {# Modified Z-Score (Iglewicz & Hoaglin, 1993) #}
                                                                <tr {% if mz_pct >= 5 %}class="table-warning"{% endif %}>
                                                                    <td>
                                                                        Outliers — Modified Z-Score
                                                                        <small class="text-muted d-block">Iglewicz &amp; Hoaglin (1993); |M_i| &gt; 3.5, MAD-based</small>
                                                                    </td>
                                                                    <td>
                                                                        {{ n_mz }} <span class="text-muted">({{ mz_pct }}%)</span>
                                                                        {% if mz_pct >= 10 %}<span class="badge bg-danger ms-2">High</span>
                                                                        {% elif mz_pct >= 5 %}<span class="badge bg-warning text-dark ms-2">Moderate</span>
                                                                        {% endif %}
                                                                        <small class="text-muted d-block">
                                                                            ↓ {{ out.n_lower_mzscore }} &ensp;↑ {{ out.n_upper_mzscore }}
                                                                        </small>
                                                                    </td>
                                                                </tr>

                                                                {# Standard Z-Score #}
                                                                <tr {% if z_pct >= 5 %}class="table-warning"{% endif %}>
                                                                    <td>
                                                                        Outliers — Z-Score
                                                                        <small class="text-muted d-block">|z| &gt; 3.0; sensitive to non-normal distributions</small>
                                                                    </td>
                                                                    <td>
                                                                        {{ n_z }} <span class="text-muted">({{ z_pct }}%)</span>
                                                                        {% if z_pct >= 10 %}<span class="badge bg-danger ms-2">High</span>
                                                                        {% elif z_pct >= 5 %}<span class="badge bg-warning text-dark ms-2">Moderate</span>
                                                                        {% endif %}
                                                                        <small class="text-muted d-block">
                                                                            ↓ {{ out.n_lower_zscore }} &ensp;↑ {{ out.n_upper_zscore }}
                                                                        </small>
                                                                    </td>
                                                                </tr>
                                                            {% else %}
                                                                <tr>
                                                                    <td>Outlier Detection</td>
                                                                    <td class="text-muted">
                                                                        Not performed
                                                                        <small class="d-block">Requires ≥ 20 values with &gt; 10 distinct values and IQR &gt; 0</small>
                                                                    </td>
                                                                </tr>
                                                            {% endif %}

                                                            <tr><td>Memory</td><td>{{ ov.memory }}</td></tr>

                                                            </tbody>
                                                        </table>
                                                        {% endif %}
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% endif %}
                                        <!-- Categorical Overview -->
                                        {% if col.type in ['object', 'bool', 'str'] and col.type not in ['int64', 'float64'] %}
                                            <div class="tab-pane fade" id="catStats{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel"
                                                 aria-labelledby="cat-stats-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                {% for cat in categorical %}
                                                    {% if col.name == cat.name %}
                                                        <div class="table-responsive mt-3" style="max-height: 400px; overflow-x: auto; overflow-y: auto;">
                                                            <table class="table table-sm table-striped w-100" style="min-width: 400px;">
                                                                <thead class="sticky-top bg-light">
                                                                <tr>
                                                                    <th style="text-align: left;width:50%">Statistic</th>
                                                                    <th style="text-align: left;">Value</th>
                                                                </tr>
                                                                </thead>
                                                                <tbody>

                                                                {# ── Distribution & Diversity ── #}
                                                                <tr class="table-secondary">
                                                                    <td colspan="2"><strong>Distribution &amp; Diversity</strong></td>
                                                                </tr>
                                                                <tr><td>Unique Categories</td><td>{{ cat.unique_categories }}</td></tr>
                                                                <tr><td>Mode</td><td>{{ cat.mode }}</td></tr>
                                                                <tr>
                                                                    <td>Entropy</td>
                                                                    <td>
                                                                        {{ cat.entropy }}
                                                                        {% if cat.entropy is not none and cat.entropy < 1.0 %}
                                                                            <span class="badge bg-warning text-dark ms-2"
                                                                                  title="Low entropy — distribution is highly concentrated">Low diversity</span>
                                                                        {% endif %}
                                                                    </td>
                                                                </tr>
                                                                <tr><td>Gini Coefficient</td><td>{{ cat.gini }}</td></tr>
                                                                <tr><td>Simpson Diversity</td><td>{{ cat.simpson_diversity }}</td></tr>

                                                                {# ── Imbalance & Rarity ── #}
                                                                <tr class="table-secondary">
                                                                    <td colspan="2"><strong>Imbalance &amp; Rarity</strong></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        Class Imbalance Ratio
                                                                        <small class="text-muted d-block" style="font-size:0.8em;">most common / least common</small>
                                                                    </td>
                                                                    <td>
                                                                        {% if cat.cib_ratio is defined %}
                                                                            {{ cat.cib_ratio | round(2) }}×
                                                                            {% if cat.cib_ratio > 10 %}
                                                                                <span class="badge bg-danger ms-2"
                                                                                      title="Severe imbalance — consider oversampling or stratified splits">Severe</span>
                                                                            {% elif cat.cib_ratio > 3 %}
                                                                                <span class="badge bg-warning text-dark ms-2"
                                                                                      title="Moderate imbalance">Moderate</span>
                                                                            {% else %}
                                                                                <span class="badge bg-success ms-2">Balanced</span>
                                                                            {% endif %}
                                                                        {% else %}—{% endif %}
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        Rare Categories
                                                                        <small class="text-muted d-block" style="font-size:0.8em;">frequency &lt; 1%</small>
                                                                    </td>
                                                                    <td>
                                                                        {% if cat.rare_categories is defined %}
                                                                            {{ cat.rare_categories }}
                                                                            {% if cat.rare_categories > 0 %}
                                                                                <span class="badge bg-secondary ms-2"
                                                                                      title="May cause unseen-category errors during train/test splits">
                                                                                    Low support
                                                                                </span>
                                                                            {% endif %}
                                                                        {% else %}—{% endif %}
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        Top-1 Coverage
                                                                        <small class="text-muted d-block" style="font-size:0.8em;">near-zero variance indicator</small>
                                                                    </td>
                                                                    <td>
                                                                        {% if cat.top_1_coverage is defined %}
                                                                            {{ (cat.top_1_coverage * 100) | round(2) }}%
                                                                            {% if cat.top_1_coverage >= 0.95 %}
                                                                                <span class="badge bg-danger ms-2"
                                                                                      title="Near-zero variance — column may be uninformative for ML">NZV</span>
                                                                            {% endif %}
                                                                        {% else %}—{% endif %}
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        Top-5 Coverage
                                                                        <small class="text-muted d-block" style="font-size:0.8em;">share of the 5 most frequent categories</small>
                                                                    </td>
                                                                    <td>
                                                                        {% if cat.top_5_coverage is defined %}
                                                                            {{ (cat.top_5_coverage * 100) | round(2) }}%
                                                                        {% else %}—{% endif %}
                                                                    </td>
                                                                </tr>

                                                                {# ── Cardinality ── #}
                                                                <tr class="table-secondary">
                                                                    <td colspan="2"><strong>Cardinality</strong></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        Effective Cardinality
                                                                        <small class="text-muted d-block" style="font-size:0.8em;">unique / total (%)</small>
                                                                    </td>
                                                                    <td>
                                                                        {% if cat.effective_cardinality is defined %}
                                                                            {{ cat.effective_cardinality | round(2) }}%
                                                                            {% if cat.effective_cardinality > 50 %}
                                                                                <span class="badge bg-warning text-dark ms-2"
                                                                                      title="High cardinality — encoding may be expensive">High</span>
                                                                            {% endif %}
                                                                        {% else %}—{% endif %}
                                                                    </td>
                                                                </tr>
                                                                <tr><td>Cardinality Ratio</td><td>{{ cat.cardinality_ratio }}</td></tr>
                                                                <tr><td>Min Category Length</td><td>{{ cat.min_category_length }}</td></tr>
                                                                <tr><td>Max Category Length</td><td>{{ cat.max_category_length }}</td></tr>
                                                                <tr><td>Memory</td><td>{{ cat.memory }}</td></tr>

                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    {% endif %}
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% elif col.missing_per == 100 %}
                                    <div class="alert alert-danger mt-3">
                                        <strong>Note:</strong> This column is empty.
                                    </div>
                                {% endif %}
                                <!-- New section for sequence analysis (sequence columns only) -->
                                {% if col.sequence != 'None' and col.dna_rna_data and col.missing_per < 100  %}
                                    <div class="row w-100 mt-4">
                                        <div class="col-12">
                                            <h5>Sequence Analysis
                                                <small class="text-muted fw-normal ms-1" style="font-size: 0.75em;">
                                                    — Statistics, Distributions: all sequences &nbsp;|&nbsp; Sequences, K-mers: Top {{ top_n }}
                                                </small>
                                            </h5>

                                            <ul class="nav nav-tabs" id="sequenceTab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tablist">
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link active" id="sequences-tab{{ col.name | replace(' ', '') |replace('.', '_') | replace('#', '') | capitalize }}"
                                                            data-bs-toggle="tab" data-bs-target="#sequences{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            type="button" role="tab">
                                                        Sequences
                                                        <span class="badge bg-secondary ms-1" style="font-size:0.7em;" title="Based on the {{ top_n }} most frequent sequences">Top {{ top_n }}</span>
                                                    </button>
                                                </li>
                                                {% if col.invalid_seqs and col.invalid_seqs|length > 0 %}
                                                    <li class="nav-item" role="presentation">
                                                        <button class="nav-link" id="invalid-seq-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                                data-bs-toggle="tab" data-bs-target="#invalidSeqs{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                                type="button" role="tab">Invalid Sequences</button>
                                                    </li>
                                                {% endif %}
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link" id="stats-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            data-bs-toggle="tab" data-bs-target="#stats{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            type="button" role="tab">
                                                        Statistics
                                                        <span class="badge bg-success ms-1" style="font-size:0.7em;" title="Computed over all sequences in this column">All</span>
                                                    </button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link" id="distributions-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            data-bs-toggle="tab" data-bs-target="#distributions{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            type="button" role="tab">
                                                        Distributions
                                                        <span class="badge bg-success ms-1" style="font-size:0.7em;" title="Computed over all sequences in this column">All</span>
                                                    </button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link" id="kmers-tab{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            data-bs-toggle="tab" data-bs-target="#kmers{{col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            type="button" role="tab">
                                                        K-mers
                                                        <span class="badge bg-secondary ms-1" style="font-size:0.7em;" title="Based on the {{ top_n }} most frequent sequences">Top {{ top_n }}</span>
                                                    </button>
                                                </li>
                                            </ul>

                                            <div class="tab-content" id="sequenceTabContent{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">

                                                <!-- ── Sequences Tab ── -->
                                                <div class="tab-pane fade show active" id="sequences{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel"
                                                     aria-labelledby="sequences-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                    <div class="table-responsive mt-3" style="max-height: 400px; overflow-y: auto;">
                                                        <table class="table table-sm table-striped">
                                                            <thead class="sticky-top bg-light">
                                                            <tr>
                                                                <th>Rank</th>
                                                                <th>Sequence</th>
                                                                <th>Count</th>
                                                                <th>Length (bp)</th>
                                                                <th>GC (%)</th>
                                                                <th>N-Count</th>
                                                            </tr>
                                                            </thead>
                                                            <tbody>
                                                            {% for i in range(col.dna_rna_data.sequence|length) %}
                                                                {% set nuc = col.dna_rna_data.nucleotide_count[i] if col.dna_rna_data.nucleotide_count|length > i else {} %}
                                                                {% set n_count = nuc.get('N', 0) %}
                                                                <tr {% if n_count > 0 %}class="table-warning"{% endif %}>
                                                                    <td>{{ i + 1 }}</td>
                                                                    <td>
                                                                        <span class="text-break" style="font-size: 0.85em;">
                                                                            {% set seq = col.dna_rna_data.sequence[i] %}
                                                                            {% if seq|length > 50 %}
                                                                                {{ seq[:25] }}<span class="text-muted">...</span>{{ seq[-25:] }}
                                                                            {% else %}
                                                                                {{ seq }}
                                                                            {% endif %}
                                                                        </span>
                                                                    </td>
                                                                    <td>{{ col.dna_rna_data.count[i] }}</td>
                                                                    <td>{{ col.dna_rna_data.length[i] }}</td>
                                                                    <td>
                                                                        {% set nuc = col.dna_rna_data.nucleotide_count[i] if col.dna_rna_data.nucleotide_count|length > i else {} %}
                                                                        {% set gc_total = nuc.get('G', 0) + nuc.get('C', 0) %}
                                                                        {% set nuc_total = nuc.values()|sum %}
                                                                        {% if nuc_total > 0 %}
                                                                            {{ (gc_total / nuc_total * 100) | round(1) }}%
                                                                        {% else %}—{% endif %}
                                                                    </td>
                                                                    <td>
                                                                        {% if n_count > 0 %}
                                                                            <span class="badge bg-warning text-dark">{{ n_count }}</span>
                                                                        {% else %}
                                                                            <span class="text-muted">0</span>
                                                                        {% endif %}
                                                                    </td>
                                                                </tr>
                                                            {% endfor %}
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>

                                                <!-- ── Invalid Sequences Tab ── -->
                                                {% if col.invalid_seqs and col.invalid_seqs|length > 0 %}
                                                    <div class="tab-pane fade" id="invalidSeqs{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel"
                                                         aria-labelledby="invalid-seq-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                        <div class="alert alert-warning mt-3">
                                                            <strong>Note:</strong> {{ col.invalid_seqs|length }} invalid sequence(s) detected in <b>{{ col.sequence }}</b> column.
                                                        </div>
                                                        <div class="table-responsive mt-3" style="max-height: 400px; overflow-y: auto;">
                                                            <table class="table table-sm table-striped w-100" style="min-width: 500px;">
                                                                <thead class="sticky-top bg-light">
                                                                <tr><th>#</th><th>Value</th></tr>
                                                                </thead>
                                                                <tbody>
                                                                {% for seq in col.invalid_seqs %}
                                                                    <tr>
                                                                        <td>{{ loop.index }}</td>
                                                                        <td>
                                                                            {% if seq|length > 50 %}
                                                                                {{ seq[:25] }}<span class="text-muted">...</span>{{ seq[-25:] }}
                                                                            {% else %}
                                                                                {{ seq }}
                                                                            {% endif %}
                                                                        </td>
                                                                    </tr>
                                                                {% endfor %}
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                {% endif %}

                                                <!-- ── Statistics Tab ── -->
                                                <div class="tab-pane fade" id="stats{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel"
                                                     aria-labelledby="stats-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                    {% set d = col.dna_rna_data %}
                                                    <div class="table-responsive mt-3">
                                                        <table class="table table-sm table-striped w-100">
                                                            <thead>
                                                            <tr>
                                                                <th style="width:40%">Metric</th>
                                                                <th style="width:20%">Min</th>
                                                                <th style="width:20%">Mean</th>
                                                                <th style="width:20%">Max</th>
                                                            </tr>
                                                            </thead>
                                                            <tbody>

                                                            {# ── Length ── #}
                                                            <tr class="table-secondary">
                                                                <td colspan="4"><strong>Sequence Length</strong></td>
                                                            </tr>
                                                            {% if d.length_stats is defined %}
                                                            <tr>
                                                                <td>Length (bp)</td>
                                                                <td>{{ d.length_stats.min }}</td>
                                                                <td>{{ d.length_stats.mean }}</td>
                                                                <td>{{ d.length_stats.max }}</td>
                                                            </tr>
                                                            {% endif %}
                                                            {% if d.length_outliers is defined and d.length_outliers %}
                                                            <tr>
                                                                <td colspan="4">
                                                                    <small class="text-muted">
                                                                        <strong>Length Outliers (Adj. IQR):</strong>
                                                                        {{ d.length_outliers.n_lower_iqr }} below {{ d.length_outliers.lower_bound }} bp &nbsp;|&nbsp;
                                                                        {{ d.length_outliers.n_upper_iqr }} above {{ d.length_outliers.upper_bound }} bp &nbsp;|&nbsp;
                                                                        Medcouple: {{ d.length_outliers.medcouple }}
                                                                    </small>
                                                                </td>
                                                            </tr>
                                                            {% endif %}

                                                            {# ── GC Content ── #}
                                                            <tr class="table-secondary">
                                                                <td colspan="4"><strong>GC Content</strong></td>
                                                            </tr>
                                                            {% if d.gc_content is defined %}
                                                            <tr>
                                                                <td>GC (%)</td>
                                                                <td>{{ d.gc_content.min }}%</td>
                                                                <td>{{ d.gc_content.mean }}%</td>
                                                                <td>{{ d.gc_content.max }}%</td>
                                                            </tr>
                                                            {% endif %}

                                                            {# ── Ambiguous Bases ── #}
                                                            <tr class="table-secondary">
                                                                <td colspan="4">
                                                                    <strong>Ambiguous Bases (N)</strong>
                                                                    <br><small class="text-muted">poor sequencing quality indicator</small>
                                                                </td>
                                                            </tr>
                                                            {% if d.ambiguous_base_ratio is defined %}
                                                            <tr {% if d.ambiguous_base_ratio.mean >= 5 %}class="table-danger"{% elif d.ambiguous_base_ratio.mean > 0 %}class="table-warning"{% endif %}>
                                                                <td>N-Rate (%)</td>
                                                                <td>{{ d.ambiguous_base_ratio.min }}%</td>
                                                                <td>
                                                                    {{ d.ambiguous_base_ratio.mean }}%
                                                                    {% if d.ambiguous_base_ratio.mean >= 5 %}
                                                                        <span class="badge bg-danger ms-1">High</span>
                                                                    {% elif d.ambiguous_base_ratio.mean > 0 %}
                                                                        <span class="badge bg-warning text-dark ms-1">Present</span>
                                                                    {% endif %}
                                                                </td>
                                                                <td>{{ d.ambiguous_base_ratio.max }}%</td>
                                                            </tr>
                                                            {% endif %}

                                                            {# ── Codon Completeness ── #}
                                                            <tr class="table-secondary">
                                                                <td colspan="4">
                                                                    <strong>Codon Completeness</strong>
                                                                    <br><small class="text-muted">length divisible by 3</small>
                                                                </td>
                                                            </tr>
                                                            {% if d.codon_completeness is defined %}
                                                            <tr {% if d.codon_completeness.mean < 90 %}class="table-warning"{% endif %}>
                                                                <td>Complete Codons (%)</td>
                                                                <td>{{ d.codon_completeness.min }}%</td>
                                                                <td>
                                                                    {{ d.codon_completeness.mean }}%
                                                                    {% if d.codon_completeness.mean < 90 %}
                                                                        <span class="badge bg-warning text-dark ms-1"
                                                                              title="Many sequences are not divisible by 3 — possible frameshift or truncation">Incomplete</span>
                                                                    {% endif %}
                                                                </td>
                                                                <td>{{ d.codon_completeness.max }}%</td>
                                                            </tr>
                                                            {% endif %}

                                                            {# ── Low Complexity ── #}
                                                            <tr class="table-secondary">
                                                                <td colspan="4">
                                                                    <strong>Sequence Complexity</strong>
                                                                    <br><small class="text-muted">normalized Shannon entropy — low = poly-A / repeats</small>
                                                                </td>
                                                            </tr>
                                                            {% if d.low_complexity is defined %}
                                                            <tr {% if d.low_complexity.mean < 50 %}class="table-warning"{% endif %}>
                                                                <td>Entropy (%)</td>
                                                                <td>{{ d.low_complexity.min }}%</td>
                                                                <td>
                                                                    {{ d.low_complexity.mean }}%
                                                                    {% if d.low_complexity.mean < 50 %}
                                                                        <span class="badge bg-warning text-dark ms-1">Low Complexity</span>
                                                                    {% endif %}
                                                                </td>
                                                                <td>{{ d.low_complexity.max }}%</td>
                                                            </tr>
                                                            {% endif %}

                                                            {# ── Composition ── #}
                                                            <tr class="table-secondary">
                                                                <td colspan="4">
                                                                    <strong>Composition</strong>
                                                                    <br><small class="text-muted">0 = no bias; ±1 = extreme strand asymmetry</small>
                                                                </td>
                                                            </tr>
                                                            {% if d.gc_skew is defined %}
                                                            <tr>
                                                                <td>GC Skew  <small class="text-muted">(G−C)/(G+C)</small></td>
                                                                <td>{{ d.gc_skew.min }}</td>
                                                                <td>{{ d.gc_skew.mean }}</td>
                                                                <td>{{ d.gc_skew.max }}</td>
                                                            </tr>
                                                            {% endif %}
                                                            {% if d.at_skew is defined %}
                                                            <tr>
                                                                <td>AT Skew  <small class="text-muted">(A−T)/(A+T)</small></td>
                                                                <td>{{ d.at_skew.min }}</td>
                                                                <td>{{ d.at_skew.mean }}</td>
                                                                <td>{{ d.at_skew.max }}</td>
                                                            </tr>
                                                            {% endif %}

                                                            {# ── Dinucleotide O/E ── #}
                                                            <tr class="table-secondary">
                                                                <td colspan="4">
                                                                    <strong>Dinucleotide Frequencies (Observed / Expected)</strong>
                                                                    <br><small class="text-muted">CpG &lt; 0.6 = methylation suppression; TpA &lt; 0.6 = avoidance</small>
                                                                </td>
                                                            </tr>
                                                            {% if d.cpg_observed_expected is defined %}
                                                            {% set cpg = d.cpg_observed_expected %}
                                                            <tr {% if cpg.mean < 0.6 %}class="table-warning"{% endif %}>
                                                                <td>CpG O/E</td>
                                                                <td>{{ cpg.min }}</td>
                                                                <td>
                                                                    {{ cpg.mean }}
                                                                    {% if cpg.mean < 0.6 %}
                                                                        <span class="badge bg-warning text-dark ms-1"
                                                                              title="CpG suppression detected — possible methylation">Suppressed</span>
                                                                    {% elif cpg.mean > 1.5 %}
                                                                        <span class="badge bg-info ms-1"
                                                                              title="CpG enrichment — possible CpG island">CpG Island</span>
                                                                    {% endif %}
                                                                </td>
                                                                <td>{{ cpg.max }}</td>
                                                            </tr>
                                                            {% endif %}
                                                            {% if d.tpa_observed_expected is defined %}
                                                            {% set tpa = d.tpa_observed_expected %}
                                                            <tr {% if tpa.mean < 0.6 %}class="table-warning"{% endif %}>
                                                                <td>TpA O/E</td>
                                                                <td>{{ tpa.min }}</td>
                                                                <td>
                                                                    {{ tpa.mean }}
                                                                    {% if tpa.mean < 0.6 %}
                                                                        <span class="badge bg-warning text-dark ms-1"
                                                                              title="TpA avoidance — common in many vertebrate genomes">Avoidance</span>
                                                                    {% endif %}
                                                                </td>
                                                                <td>{{ tpa.max }}</td>
                                                            </tr>
                                                            {% endif %}

                                                            {# ── Reverse Complement Duplicates ── #}
                                                            <tr class="table-secondary">
                                                                <td colspan="4">
                                                                    <strong>Reverse Complement Duplicates</strong>
                                                                    <br><small class="text-muted">possible library prep artefact or paired-end overlap</small>
                                                                </td>
                                                            </tr>
                                                            {% if d.reverse_complement_ratio is defined %}
                                                            <tr {% if d.reverse_complement_ratio >= 10 %}class="table-danger"{% elif d.reverse_complement_ratio > 0 %}class="table-warning"{% endif %}>
                                                                <td>RC Duplicate Rate</td>
                                                                <td colspan="3">
                                                                    {{ d.reverse_complement_ratio }}%
                                                                    {% if d.reverse_complement_ratio >= 10 %}
                                                                        <span class="badge bg-danger ms-2">High</span>
                                                                    {% elif d.reverse_complement_ratio > 0 %}
                                                                        <span class="badge bg-warning text-dark ms-2">Present</span>
                                                                    {% endif %}
                                                                    {% if d.reverse_complement_list and d.reverse_complement_list|length > 0 %}
                                                                        <details class="mt-2">
                                                                            <summary class="text-muted small" style="cursor:pointer;">
                                                                                Show {{ d.reverse_complement_list|length }} affected sequence(s)
                                                                            </summary>
                                                                            <div class="mt-1" style="max-height:150px;overflow-y:auto;">
                                                                                {% for rc_seq in d.reverse_complement_list %}
                                                                                    <code class="d-block text-break small">
                                                                                        {% if rc_seq|length > 60 %}
                                                                                            {{ rc_seq[:30] }}…{{ rc_seq[-30:] }}
                                                                                        {% else %}
                                                                                            {{ rc_seq }}
                                                                                        {% endif %}
                                                                                    </code>
                                                                                {% endfor %}
                                                                            </div>
                                                                        </details>
                                                                    {% endif %}
                                                                </td>
                                                            </tr>
                                                            {% endif %}

                                                            {# ── Nucleotide Composition (Top-N aggregated) ── #}
                                                            <tr class="table-secondary">
                                                                <td colspan="4">
                                                                    <strong>Nucleotide Composition</strong>
                                                                    <br><small class="text-muted">aggregated from Top {{ top_n }}</small>
                                                                </td>
                                                            </tr>
                                                            {% set all_nucleotides = {} %}
                                                            {% for nuc_dict in d.nucleotide_count %}
                                                                {% for base, cnt in nuc_dict.items() %}
                                                                    {% if all_nucleotides.update({base: all_nucleotides.get(base, 0) + cnt}) %}{% endif %}
                                                                {% endfor %}
                                                            {% endfor %}
                                                            {% set total_nucleotides = all_nucleotides.values()|sum %}
                                                            {% for base, cnt in all_nucleotides.items()|sort(attribute='1', reverse=true) %}
                                                            <tr>
                                                                <td>{{ base }}</td>
                                                                <td colspan="2">{{ cnt }}</td>
                                                                <td>{{ "%.2f"|format((cnt / total_nucleotides) * 100) }}%</td>
                                                            </tr>
                                                            {% endfor %}

                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>

                                                <!-- ── Distributions Tab ── -->
                                                <div class="tab-pane fade" id="distributions{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel"
                                                     aria-labelledby="distributions-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                    {% set d = col.dna_rna_data %}
                                                    <div class="mt-3">
                                                        {# GC Content Distribution #}
                                                        {% if d.gc_distribution %}
                                                            <h6>GC Content Distribution</h6>
                                                            <p class="text-muted small">Violin plot of per-sequence GC content across all sequences. Bimodal distributions may indicate contamination from a second organism.</p>
                                                            <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                                                <figure role="img" aria-label="Violin plot of GC content distribution per sequence in column {{ col.name }}">
                                                                    {{ d.gc_distribution | safe }}
                                                                </figure>
                                                            </div>
                                                        {% endif %}

                                                        {# AT/GC Skewness #}
                                                        {% if d.at_gc_skewness %}
                                                            <hr>
                                                            <h6>AT / GC Skewness</h6>
                                                            <p class="text-muted small">Scatter plot of AT skew vs. GC skew per sequence. Deviation from (0, 0) indicates strand asymmetry.</p>
                                                            <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                                                <figure role="img" aria-label="Scatter plot of AT skew versus GC skew per sequence in column {{ col.name }}">
                                                                    {{ d.at_gc_skewness | safe }}
                                                                </figure>
                                                            </div>
                                                        {% endif %}

                                                        {# Length Distribution #}
                                                        {% if d.length_distribution %}
                                                            <hr>
                                                            <h6>Sequence Length Distribution</h6>
                                                            <p class="text-muted small">Histogram of sequence lengths across all sequences. High variance may indicate mixed amplicons or assembly artefacts.</p>
                                                            <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                                                <figure role="img" aria-label="Histogram of sequence lengths in column {{ col.name }}">
                                                                    {{ d.length_distribution | safe }}
                                                                </figure>
                                                            </div>
                                                        {% else %}
                                                            <div class="alert alert-secondary mt-3">All sequences have equal length — length distribution plot not generated.</div>
                                                        {% endif %}

                                                        {# Ambiguous Base Distribution #}
                                                        {% if d.ambiguous_distribution %}
                                                            <hr>
                                                            <h6>Ambiguous Base (N) Distribution</h6>
                                                            <p class="text-muted small">N-count per sequence in chronological order. Spikes may indicate specific flowcell tiles or regions with poor sequencing quality.</p>
                                                            <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                                                <figure role="img" aria-label="Distribution of ambiguous base (N) counts per sequence in column {{ col.name }}">
                                                                    {{ d.ambiguous_distribution | safe }}
                                                                </figure>
                                                            </div>
                                                        {% elif d.ambiguous_base_ratio is defined and d.ambiguous_base_ratio.mean == 0 %}
                                                            <div class="alert alert-success mt-3">No ambiguous bases (N) detected — distribution plot not generated.</div>
                                                        {% endif %}
                                                    </div>
                                                </div>

                                                <!-- ── K-mers Tab ── -->
                                                <div class="tab-pane fade" id="kmers{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel"
                                                     aria-labelledby="kmers-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                    {% if col.dna_rna_data.plot %}
                                                        <div class="row w-100">
                                                            <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                                                <figure role="img" aria-label="K-mer frequency plot for column {{ col.name }}">
                                                                    {{ col.dna_rna_data.plot | safe }}
                                                                </figure>
                                                            </div>
                                                        </div>
                                                    {% endif %}
                                                    <div class="mt-3">
                                                        <h6>Most Common K-mers per Sequence</h6>
                                                        <div class="accordion" id="kmerAccordion{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                            {% for i in range(col.dna_rna_data.sequence|length) %}
                                                                {% if col.dna_rna_data.k_mers[i] %}
                                                                    <div class="accordion-item">
                                                                        <h2 class="accordion-header">
                                                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                                                                    data-bs-target="#kmer{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}{{ i }}"
                                                                                    aria-expanded="false"
                                                                                    aria-controls="kmer{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}{{ i }}">
                                                                                <strong>#{{ i + 1 }}</strong> &nbsp;{{ col.dna_rna_data.sequence[i]|truncate(20, True, "...")}} ({{ col.dna_rna_data.length[i] }} bp)
                                                                            </button>
                                                                        </h2>
                                                                        <div id="kmer{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}{{ i }}"
                                                                             class="accordion-collapse collapse"
                                                                             data-bs-parent="#kmerAccordion{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                                            <div class="accordion-body">
                                                                                <table class="table table-sm">
                                                                                    <thead>
                                                                                    <tr><th>K-mer</th><th>Count</th></tr>
                                                                                    </thead>
                                                                                    <tbody>
                                                                                    {% for kmer, count in col.dna_rna_data.k_mers[i] %}
                                                                                        <tr>
                                                                                            <td>{{ kmer }}</td>
                                                                                            <td>{{ count }}</td>
                                                                                        </tr>
                                                                                    {% endfor %}
                                                                                    </tbody>
                                                                                </table>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                {% endif %}
                                                            {% endfor %}
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                {% endif %}

                                <!-- Protein Sequenz Sektion -->
                                {% if col.sequence != 'None' and col.protein_data and col.missing_per < 100 %}
                                    <div class="row w-100 mt-4">
                                        <div class="col-12">
                                            <h5>Top {{ top_n }} Protein Sequences Analysis
                                                <small class="text-muted fw-normal ms-1" style="font-size: 0.75em;">
                                                    — Statistics, Distributions: all sequences &nbsp;|&nbsp; Sequences, Composition, Properties, K-mers: Top {{ top_n }}
                                                </small>
                                            </h5>

                                            <!-- Tabs für verschiedene Ansichten -->
                                            <ul class="nav nav-tabs" id="proteinTab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tablist">
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link active" id="protein-sequences-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            data-bs-toggle="tab" data-bs-target="#proteinSequences{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            type="button" role="tab">
                                                        Sequences
                                                        <span class="badge bg-secondary ms-1" style="font-size:0.7em;" title="Based on the {{ top_n }} most frequent sequences">Top {{ top_n }}</span>
                                                    </button>
                                                </li>
                                                {% if col.invalid_seqs and col.invalid_seqs|length > 0 %}
                                                    <li class="nav-item" role="presentation">
                                                        <button class="nav-link" id="invalid-seq-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                                data-bs-toggle="tab" data-bs-target="#invalidSeqs{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                                type="button" role="tab">Invalid Sequences</button>
                                                    </li>
                                                {% endif %}
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link" id="protein-stats-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            data-bs-toggle="tab" data-bs-target="#proteinStats{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            type="button" role="tab">
                                                        Statistics
                                                        <span class="badge bg-success ms-1" style="font-size:0.7em;" title="Computed over all sequences in this column">All</span>
                                                    </button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link" id="protein-composition-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            data-bs-toggle="tab" data-bs-target="#proteinComposition{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            type="button" role="tab">
                                                        Amino Acid Composition
                                                        <span class="badge bg-secondary ms-1" style="font-size:0.7em;" title="Based on the {{ top_n }} most frequent sequences">Top {{ top_n }}</span>
                                                    </button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link" id="protein-properties-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            data-bs-toggle="tab" data-bs-target="#proteinProperties{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            type="button" role="tab">
                                                        Protein Properties
                                                        <span class="badge bg-secondary ms-1" style="font-size:0.7em;" title="Based on the {{ top_n }} most frequent sequences">Top {{ top_n }}</span>
                                                    </button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link" id="protein-distributions-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            data-bs-toggle="tab" data-bs-target="#proteinDistributions{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            type="button" role="tab">
                                                        Distributions
                                                        <span class="badge bg-success ms-1" style="font-size:.7em;" title="Computed over all sequences in this column">All</span>
                                                    </button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link" id="protein-kmers-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            data-bs-toggle="tab" data-bs-target="#proteinKmers{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}"
                                                            type="button" role="tab">
                                                        K-mers
                                                        <span class="badge bg-secondary ms-1" style="font-size:0.7em;" title="Based on the {{ top_n }} most frequent sequences">Top {{ top_n }}</span>
                                                    </button>
                                                </li>
                                            </ul>

                                            <div class="tab-content" id="proteinTabContent{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                <!-- Protein Sequences Tab -->
                                                <div class="tab-pane fade show active" id="proteinSequences{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel">
                                                    <div class="table-responsive mt-3" style="max-height: 400px; overflow-y: auto;">
                                                        <table class="table table-sm table-striped">
                                                            <thead class="sticky-top bg-light">
                                                            <tr>
                                                                <th>Rank</th>
                                                                <th>Sequence</th>
                                                                <th>Count</th>
                                                                <th>Length (AA)</th>
                                                                <th>Frequency</th>
                                                                <th>Molecular Weight (Da)</th>
                                                                <th>Isoelectric Point (pI)</th>
                                                            </tr>
                                                            </thead>
                                                            <tbody>
                                                            {% for i in range(col.protein_data.sequence|length) %}
                                                                <tr>
                                                                    <td>{{ i + 1 }}</td>
                                                                    <td>
                                                                        <span class="text-break" style="font-size: 0.85em;">
                                                                            {% set seq = col.protein_data.sequence[i] %}
                                                                            {% if seq|length > 50 %}
                                                                                {{ seq[:25] }}<span class="text-muted">...</span>{{ seq[-25:] }}
                                                                            {% else %}
                                                                                {{ seq }}
                                                                            {% endif %}
                                                                        </span>
                                                                    </td>
                                                                    <td>{{ col.protein_data.count[i] }}</td>
                                                                    <td>{{ col.protein_data.length[i] }}</td>
                                                                    <td>
                                                                        {% set aa_names = {
                                                                            'A': 'Ala', 'R': 'Arg', 'N': 'Asn', 'D': 'Asp', 'C': 'Cys',
                                                                            'E': 'Glu', 'Q': 'Gln', 'G': 'Gly', 'H': 'His', 'I': 'Ile',
                                                                            'L': 'Leu', 'K': 'Lys', 'M': 'Met', 'F': 'Phe', 'P': 'Pro',
                                                                            'S': 'Ser', 'T': 'Thr', 'W': 'Trp', 'Y': 'Tyr', 'V': 'Val'
                                                                        } %}
                                                                        {% for key, value in col.protein_data.frequency[i].items() %}
                                                                            {% if value != 0 %}
                                                                                {% set percentage = value * 100 %}
                                                                                <div class="mb-1">
                                                                                    <span class="fw-bold">{{ aa_names.get(key, 'Unk') }}</span>
                                                                                    <span class="ms-2">{{ "%.2f"|format(percentage) }} %</span>
                                                                                    <div class="progress" style="height: 16px;">
                                                                                        <div class="progress-bar bg-primary" role="progressbar"
                                                                                             style="width: {{ percentage }}%"
                                                                                             aria-valuenow="{{ percentage }}" aria-valuemin="0" aria-valuemax="100">
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            {% endif %}
                                                                        {% endfor %}
                                                                    </td>
                                                                    <td>{{ "%.1f"|format(col.protein_data.molecular_weight[i]) }}</td>
                                                                    <td>{{ "%.2f"|format(col.protein_data.isoelectric_point[i]) }}</td>

                                                                </tr>
                                                            {% endfor %}
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                                <!-- Invalid Sequences Tab -->
                                                {% if col.invalid_seqs and col.invalid_seqs|length > 0 %}
                                                    <div class="tab-pane fade" id="invalidSeqs{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel"
                                                         aria-labelledby="invalid-seq-tab{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                        <div class="alert alert-warning mt-3">
                                                            <strong>Note:</strong> {{ col.invalid_seqs|length }} invalid sequence(s) detected in {{ col.sequence }} column.
                                                        </div>
                                                        <div class="table-responsive mt-3" style="max-height: 400px; overflow-y: auto;">
                                                            <table class="table table-sm table-striped w-100" style="min-width: 500px;">
                                                                <thead class="sticky-top bg-light">
                                                                <tr>
                                                                    <th>#</th>
                                                                    <th>Value</th>
                                                                </tr>
                                                                </thead>
                                                                <tbody>
                                                                {% for seq in col.invalid_seqs %}
                                                                    <tr>
                                                                        <td>{{ loop.index }}</td>
                                                                        <td>
                                                                            {% if seq|length > 50 %}
                                                                                {{ seq[:25] }}<span class="text-muted">...</span>{{ seq[-25:] }}
                                                                            {% else %}
                                                                                {{ seq }}
                                                                            {% endif %}
                                                                        </td>
                                                                    </tr>
                                                                {% endfor %}
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                {% endif %}

                                                <!-- Protein Statistics Tab -->
                                                <div class="tab-pane fade" id="proteinStats{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel">
                                                    {% set pd = col.protein_data %}
                                                    <div class="table-responsive mt-3">
                                                        <table class="table table-sm table-striped w-100">
                                                            <thead>
                                                            <tr>
                                                                <th style="width:40%">Metric</th>
                                                                <th style="width:20%">Min</th>
                                                                <th style="width:20%">Mean</th>
                                                                <th style="width:20%">Max</th>
                                                            </tr>
                                                            </thead>
                                                            <tbody>

                                                            {# ── Sequence Length ── #}
                                                            <tr class="table-secondary"><td colspan="4"><strong>Sequence Length</strong></td></tr>
                                                            {% if pd.length_stats is defined %}
                                                            <tr>
                                                                <td>Length (AA)</td>
                                                                <td>{{ pd.length_stats.min }}</td>
                                                                <td>{{ pd.length_stats.mean }}</td>
                                                                <td>{{ pd.length_stats.max }}</td>
                                                            </tr>
                                                            {% endif %}
                                                            {% if pd.length_outliers is defined and pd.length_outliers %}
                                                            <tr>
                                                                <td colspan="4">
                                                                    <small class="text-muted">
                                                                        <strong>Length Outliers (Adj. IQR):</strong>
                                                                        {{ pd.length_outliers.n_lower_iqr }} below {{ pd.length_outliers.lower_bound }} AA &nbsp;|&nbsp;
                                                                        {{ pd.length_outliers.n_upper_iqr }} above {{ pd.length_outliers.upper_bound }} AA &nbsp;|&nbsp;
                                                                        Medcouple: {{ pd.length_outliers.medcouple }}
                                                                    </small>
                                                                </td>
                                                            </tr>
                                                            {% endif %}

                                                            {# ── Ambiguous Residues ── #}
                                                            <tr class="table-secondary">
                                                                <td colspan="4">
                                                                    <strong>Ambiguous Residues (X / J / U)</strong>
                                                                    <br><small class="text-muted">non-standard or unresolved amino acids</small>
                                                                </td>
                                                            </tr>
                                                            {% if pd.ambiguous_residue_ratio is defined %}
                                                            <tr {% if pd.ambiguous_residue_ratio.mean >= 5 %}class="table-danger"{% elif pd.ambiguous_residue_ratio.mean > 0 %}class="table-warning"{% endif %}>
                                                                <td>Ambiguous Residue Rate (%)</td>
                                                                <td>{{ pd.ambiguous_residue_ratio.min }}%</td>
                                                                <td>
                                                                    {{ pd.ambiguous_residue_ratio.mean }}%
                                                                    {% if pd.ambiguous_residue_ratio.mean >= 5 %}
                                                                        <span class="badge bg-danger ms-1">High</span>
                                                                    {% elif pd.ambiguous_residue_ratio.mean > 0 %}
                                                                        <span class="badge bg-warning text-dark ms-1">Present</span>
                                                                    {% endif %}
                                                                </td>
                                                                <td>{{ pd.ambiguous_residue_ratio.max }}%</td>
                                                            </tr>
                                                            {% endif %}

                                                            {# ── Stop Codons ── #}
                                                            <tr class="table-secondary">
                                                                <td colspan="4">
                                                                    <strong>Stop Codon Presence (*)</strong>
                                                                    <br><small class="text-muted">premature stop codons may indicate translation errors or pseudogenes</small>
                                                                </td>
                                                            </tr>
                                                            {% if pd.stop_codon_ratio is defined %}
                                                            <tr {% if pd.stop_codon_ratio > 10 %}class="table-danger"{% elif pd.stop_codon_ratio > 0 %}class="table-warning"{% endif %}>
                                                                <td>Sequences with Stop Codon (%)</td>
                                                                <td colspan="3">
                                                                    {{ "%.2f"|format(pd.stop_codon_ratio) }}%
                                                                    {% if pd.stop_codon_ratio > 10 %}
                                                                        <span class="badge bg-danger ms-2">High</span>
                                                                    {% elif pd.stop_codon_ratio > 0 %}
                                                                        <span class="badge bg-warning text-dark ms-2">Present</span>
                                                                    {% endif %}
                                                                </td>
                                                            </tr>
                                                            {% endif %}

                                                            {# ── Low Complexity ── #}
                                                            <tr class="table-secondary">
                                                                <td colspan="4">
                                                                    <strong>Sequence Complexity</strong>
                                                                    <br><small class="text-muted">normalized Shannon entropy — low = homopolymers / tandem repeats</small>
                                                                </td>
                                                            </tr>
                                                            {% if pd.low_complexity is defined %}
                                                            <tr {% if pd.low_complexity.mean < 50 %}class="table-warning"{% endif %}>
                                                                <td>Entropy (%)</td>
                                                                <td>{{ pd.low_complexity.min }}%</td>
                                                                <td>
                                                                    {{ pd.low_complexity.mean }}%
                                                                    {% if pd.low_complexity.mean < 50 %}
                                                                        <span class="badge bg-warning text-dark ms-1">Low Complexity</span>
                                                                    {% endif %}
                                                                </td>
                                                                <td>{{ pd.low_complexity.max }}%</td>
                                                            </tr>
                                                            {% endif %}

                                                            {# ── Physicochemical Properties ── #}
                                                            <tr class="table-secondary"><td colspan="4"><strong>Physicochemical Properties</strong></td></tr>
                                                            {% if pd.gravy is defined %}
                                                            <tr {% if pd.gravy.mean > 0 %}class="table-info"{% endif %} title="GRAVY > 0: hydrophobic; < 0: hydrophilic">
                                                                <td>GRAVY Score <small class="text-muted">(hydropathy)</small></td>
                                                                <td>{{ "%.3f"|format(pd.gravy.min) }}</td>
                                                                <td>
                                                                    {{ "%.3f"|format(pd.gravy.mean) }}
                                                                    {% if pd.gravy.mean > 0 %}
                                                                        <span class="badge bg-info text-dark ms-1" title="Positive = hydrophobic tendency">Hydrophobic</span>
                                                                    {% elif pd.gravy.mean < -1 %}
                                                                        <span class="badge bg-secondary ms-1" title="Strongly negative = hydrophilic">Hydrophilic</span>
                                                                    {% endif %}
                                                                </td>
                                                                <td>{{ "%.3f"|format(pd.gravy.max) }}</td>
                                                            </tr>
                                                            {% endif %}
                                                            {% if pd.cysteine_count is defined %}
                                                            <tr>
                                                                <td>Cysteine Count <small class="text-muted">(disulfide bridges)</small></td>
                                                                <td>{{ pd.cysteine_count.min }}</td>
                                                                <td>{{ "%.2f"|format(pd.cysteine_count.mean) }}</td>
                                                                <td>{{ pd.cysteine_count.max }}</td>
                                                            </tr>
                                                            {% endif %}
                                                            {% if pd.disorder_propensity is defined %}
                                                            <tr {% if pd.disorder_propensity.mean > 30 %}class="table-warning"{% endif %} title="Disorder-promoting: P, E, S, Q, K">
                                                                <td>Disorder Propensity <small class="text-muted">(P,E,S,Q,K %)</small></td>
                                                                <td>{{ pd.disorder_propensity.min }}%</td>
                                                                <td>
                                                                    {{ "%.1f"|format(pd.disorder_propensity.mean) }}%
                                                                    {% if pd.disorder_propensity.mean > 30 %}
                                                                        <span class="badge bg-warning text-dark ms-1">Elevated</span>
                                                                    {% endif %}
                                                                </td>
                                                                <td>{{ pd.disorder_propensity.max }}%</td>
                                                            </tr>
                                                            {% endif %}

                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>

                                                <!-- Amino Acid Composition Tab -->
                                                <div class="tab-pane fade" id="proteinComposition{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel">
                                                    <div class="mt-3">
                                                        <h6>Amino Acid Composition
                                                            <small class="text-muted fw-normal ms-1" style="font-size:0.8em;">aggregated from Top {{ top_n }}</small>
                                                        </h6>
                                                        {% set all_amino_acids = {} %}
                                                        {% for aa_dict in col.protein_data.composition %}
                                                            {% for aa, count in aa_dict.items() %}
                                                                {% if all_amino_acids.update({aa: all_amino_acids.get(aa, 0) + count}) %}{% endif %}
                                                            {% endfor %}
                                                        {% endfor %}
                                                        {% set total_amino_acids = all_amino_acids.values()|sum %}

                                                        <div class="table-responsive">
                                                            <table class="table table-sm">
                                                                <thead>
                                                                <tr>
                                                                    <th>Amino Acid</th>
                                                                    <th>Three-Letter</th>
                                                                    <th>Count</th>
                                                                    <th>Percentage</th>
                                                                    <th style="width: 200px;">Distribution</th>
                                                                </tr>
                                                                </thead>
                                                                <tbody>
                                                                {% set aa_names = {
                                                                    'A': 'Ala', 'R': 'Arg', 'N': 'Asn', 'D': 'Asp', 'C': 'Cys',
                                                                    'E': 'Glu', 'Q': 'Gln', 'G': 'Gly', 'H': 'His', 'I': 'Ile',
                                                                    'L': 'Leu', 'K': 'Lys', 'M': 'Met', 'F': 'Phe', 'P': 'Pro',
                                                                    'S': 'Ser', 'T': 'Thr', 'W': 'Trp', 'Y': 'Tyr', 'V': 'Val'
                                                                } %}
                                                                {% for aa, count in all_amino_acids.items()|sort(attribute='1', reverse=true) %}
                                                                    {% set percentage = (count / total_amino_acids) * 100 %}
                                                                    <tr>
                                                                        <td class="fw-bold">{{ aa }}</td>
                                                                        <td>{{ aa_names.get(aa, 'Unk') }}</td>
                                                                        <td>{{ count }}</td>
                                                                        <td>{{ "%.2f"|format(percentage) }}%</td>
                                                                        <td>
                                                                            <div class="progress" style="height: 20px;">
                                                                                <div class="progress-bar bg-primary" role="progressbar"
                                                                                     style="width: {{ percentage }}%"
                                                                                     aria-valuenow="{{ percentage }}" aria-valuemin="0" aria-valuemax="100">
                                                                                </div>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                {% endfor %}
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Protein Properties Tab -->
                                                <div class="tab-pane fade" id="proteinProperties{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel">
                                                    <div class="table-responsive mt-3" style="max-height: 400px; overflow-y: auto;">
                                                        <table class="table table-sm table-striped">
                                                            <thead class="sticky-top bg-light">
                                                            <tr>
                                                                <th>Rank</th>
                                                                <th>Sequence</th>
                                                                <th>Length</th>
                                                                <th>Hydrophobicity</th>
                                                                <th>Charge</th>
                                                                <th>Aliphatic Index</th>
                                                                <th>Boman Index</th>
                                                                <th>Aromaticity</th>
                                                                <th>Instability</th>
                                                            </tr>
                                                            </thead>
                                                            <tbody>
                                                            {% for i in range(col.protein_data.sequence|length) %}
                                                                <tr>
                                                                    <td>{{  i + 1 }}</td>
                                                                    <td>
                                                                        {% if col.protein_data.sequence[i]|length > 30 %}
                                                                            {{ col.protein_data.sequence[i][:15] }}<span class="text-muted">...</span>{{ col.protein_data.sequence[i][-15:] }}
                                                                        {% else %}
                                                                            {{ col.protein_data.sequence[i] }}
                                                                        {% endif %}
                                                                    </td>
                                                                    <td>{{ col.protein_data.length[i] }}</td>
                                                                    <td>{{ "%.3f"|format(col.protein_data.hydrophobicity[i]) }}</td>
                                                                    <td>{{ "%.2f"|format(col.protein_data.charge[i]) }}</td>
                                                                    <td>{{ "%.2f"|format(col.protein_data.aliphatic_index[i]) }}</td>
                                                                    <td>{{ "%.2f"|format(col.protein_data.boman[i]) }}</td>
                                                                    <td>{{ "%.3f"|format(col.protein_data.aromaticity[i]) }}</td>
                                                                    <td>{{ "%.2f"|format(col.protein_data.instability[i]) }}</td>
                                                                </tr>
                                                            {% endfor %}
                                                            </tbody>
                                                        </table>
                                                    </div>

                                                    <div class="row mt-4">
                                                        <div class="col-md-6">
                                                            <h6>Additional Property Statistics</h6>
                                                            <table class="table table-sm">
                                                                <tr>
                                                                    <td><strong>Aliphatic Index</strong></td>
                                                                    <td>from {{ "%.2f"|format(col.protein_data.aliphatic_index|min) }} to {{ "%.2f"|format(col.protein_data.aliphatic_index|max) }}</td>
                                                                </tr>
                                                                <tr>
                                                                    <td><strong>Boman Index</strong></td>
                                                                    <td>from {{ "%.2f"|format(col.protein_data.boman|min) }} to {{ "%.2f"|format(col.protein_data.boman|max) }}</td>
                                                                </tr>
                                                                <tr>
                                                                    <td><strong>Aromaticity</strong></td>
                                                                    <td>from {{ "%.3f"|format(col.protein_data.aromaticity|min) }} to {{ "%.3f"|format(col.protein_data.aromaticity|max) }}</td>
                                                                </tr>
                                                                <tr>
                                                                    <td><strong>Instability Index</strong></td>
                                                                    <td>from {{ "%.2f"|format(col.protein_data.instability|min) }} to {{ "%.2f"|format(col.protein_data.instability|max) }}</td>
                                                                </tr>
                                                                {% if col.protein_data.gravy is defined %}
                                                                <tr>
                                                                    <td><strong>GRAVY Score</strong></td>
                                                                    <td>from {{ "%.3f"|format(col.protein_data.gravy.min) }} to {{ "%.3f"|format(col.protein_data.gravy.max) }} (mean: {{ "%.3f"|format(col.protein_data.gravy.mean) }})</td>
                                                                </tr>
                                                                {% endif %}
                                                                {% if col.protein_data.cysteine_count is defined %}
                                                                <tr>
                                                                    <td><strong>Cysteine Count</strong></td>
                                                                    <td>{{ col.protein_data.cysteine_count.min }}–{{ col.protein_data.cysteine_count.max }} (mean: {{ "%.1f"|format(col.protein_data.cysteine_count.mean) }})</td>
                                                                </tr>
                                                                {% endif %}
                                                                {% if col.protein_data.disorder_propensity is defined %}
                                                                <tr>
                                                                    <td><strong>Disorder Propensity</strong></td>
                                                                    <td>from {{ col.protein_data.disorder_propensity.min }}% to {{ col.protein_data.disorder_propensity.max }}% (mean: {{ "%.1f"|format(col.protein_data.disorder_propensity.mean) }}%)</td>
                                                                </tr>
                                                                {% endif %}
                                                            </table>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <h6>Property Interpretation</h6>
                                                            <div class="small text-muted">
                                                                <p><strong>Aliphatic Index:</strong> Relative volume of aliphatic side chains (higher = more thermostable)</p>
                                                                <p><strong>Boman Index:</strong> Protein-protein interaction potential</p>
                                                                <p><strong>Aromaticity:</strong> Fraction of aromatic amino acids (Phe, Trp, Tyr)</p>
                                                                <p><strong>Instability Index:</strong> &lt;40 = stable, &gt;40 = unstable protein</p>
                                                                <p><strong>GRAVY Score:</strong> &gt;0 = hydrophobic, &lt;0 = hydrophilic</p>
                                                                <p><strong>Cysteine Count:</strong> Relevant for disulfide bridges and structural stability</p>
                                                                <p><strong>Disorder Propensity:</strong> Fraction of disorder-promoting residues (P,E,S,Q,K) — high values suggest intrinsically disordered regions</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Protein Distributions Tab -->
                                                <div class="tab-pane fade" id="proteinDistributions{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel">
                                                    {% set pd = col.protein_data %}
                                                    <div class="mt-3">

                                                        {# ── AA Group Distribution plot ── #}
                                                        {% if pd.aa_group_plot %}
                                                            <h6>Amino Acid Group Distribution</h6>
                                                            <p class="text-muted small">Proportion of physicochemical groups across all sequences. Helps identify dominant biochemical character (hydrophobic core, charged surface, etc.).</p>
                                                            <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                                                <figure role="img" aria-label="Amino acid group distribution bar chart for column {{ col.name }}">
                                                                    {{ pd.aa_group_plot | safe }}
                                                                </figure>
                                                            </div>
                                                        {% elif pd.aa_group_distribution %}
                                                            <h6>Amino Acid Group Distribution</h6>
                                                            <div class="table-responsive mb-4" style="max-height: 300px; overflow-y: auto;">
                                                                <table class="table table-sm table-striped w-100">
                                                                    <thead class="sticky-top bg-light">
                                                                    <tr>
                                                                        <th>Group</th>
                                                                        <th>Proportion</th>
                                                                        <th style="min-width:160px;">Distribution</th>
                                                                    </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                    {% for group, proportion in pd.aa_group_distribution.items() | sort(attribute='1', reverse=true) %}
                                                                        {% set pct = (proportion * 100) | round(2) %}
                                                                        <tr>
                                                                            <td>{{ group }}</td>
                                                                            <td>{{ pct }}%</td>
                                                                            <td>
                                                                                <div class="progress" style="height:14px;">
                                                                                    <div class="progress-bar bg-primary" role="progressbar"
                                                                                         style="width:{{ pct }}%"
                                                                                         aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100">
                                                                                    </div>
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                    {% endfor %}
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        {% endif %}

                                                        {# ── Length Distribution ── #}
                                                        {% if pd.length_distribution %}
                                                            <hr>
                                                            <h6>Sequence Length Distribution</h6>
                                                            <p class="text-muted small">Histogram of protein lengths across all sequences. Multimodal distributions may indicate multiple protein families or isoforms.</p>
                                                            <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                                                <figure role="img" aria-label="Protein length distribution histogram for column {{ col.name }}">
                                                                    {{ pd.length_distribution | safe }}
                                                                </figure>
                                                            </div>
                                                        {% else %}
                                                            <div class="alert alert-secondary mt-3">All sequences have equal length — length distribution plot not generated.</div>
                                                        {% endif %}

                                                        {# ── Ambiguous Residue Distribution ── #}
                                                        {% if pd.ambiguous_distribution %}
                                                            <hr>
                                                            <h6>Ambiguous Residue (X/J/U) Distribution</h6>
                                                            <p class="text-muted small">Count of ambiguous residues per sequence. Elevated counts may indicate incomplete sequencing or database annotation issues.</p>
                                                            <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">
                                                                <figure role="img" aria-label="Ambiguous residue distribution per sequence for column {{ col.name }}">
                                                                    {{ pd.ambiguous_distribution | safe }}
                                                                </figure>
                                                            </div>
                                                        {% elif pd.ambiguous_residue_ratio is defined and pd.ambiguous_residue_ratio.mean == 0 %}
                                                            <div class="alert alert-success mt-3">No ambiguous residues (X/J/U) detected — distribution plot not generated.</div>
                                                        {% endif %}

                                                    </div>
                                                </div>

                                                <!-- K-mers Tab -->
                                                <div class="tab-pane fade" id="proteinKmers{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}" role="tabpanel">
                                                    {% if col.protein_data.plot %}
                                                        <div class="row w-100">
                                                            <div class="plot-container mb-4" style="max-height: fit-content; overflow: scroll;">{{ col.protein_data.plot | safe }}
                                                            </div>
                                                        </div>
                                                    {% endif %}
                                                    <div class="mt-3">
                                                        <h6>Most Common Peptide K-mers per Sequence</h6>
                                                        <div class="accordion" id="proteinKmerAccordion{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                            {% for i in range(col.protein_data.sequence|length) %}
                                                                {% if col.protein_data.k_mers[i] %}
                                                                    <div class="accordion-item">
                                                                        <h2 class="accordion-header">
                                                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                                                                    data-bs-target="#proteinKmer{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}{{ i }}"
                                                                                    aria-expanded="false">
                                                                                <strong>#{{ i + 1 }}</strong> &nbsp; {{ col.protein_data.sequence[i]|truncate(20, True, "...") }} ({{ col.protein_data.length[i] }} AA)
                                                                            </button>
                                                                        </h2>
                                                                        <div id="proteinKmer{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}{{ i }}"
                                                                             class="accordion-collapse collapse"
                                                                             data-bs-parent="#proteinKmerAccordion{{ col.name | replace(' ', '') | replace('.', '_') | replace('#', '') | capitalize }}">
                                                                            <div class="accordion-body">
                                                                                <table class="table table-sm">
                                                                                    <thead>
                                                                                    <tr><th>Peptide K-mer</th><th>Count</th></tr>
                                                                                    </thead>
                                                                                    <tbody>
                                                                                    {% for kmer, count in col.protein_data.k_mers[i] %}
                                                                                        <tr>
                                                                                            <td>{{ kmer }}</td>
                                                                                            <td>{{ count }}</td>
                                                                                        </tr>
                                                                                    {% endfor %}
                                                                                    </tbody>
                                                                                </table>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                {% endif %}
                                                            {% endfor %}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Pagination Controls (Bottom) -->
            {% if total_pages > 1 %}
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                <span class="text-muted">
                    Page <span id="current-page-info">1</span> of {{ total_pages }}
                </span>
                            </div>
                            <nav aria-label="Column pagination">
                                <ul class="pagination mb-0" id="column-pagination-bottom"></ul>
                            </nav>
                        </div>
                    </div>
                </div>
            {% endif %}

        </div>
    </div>
    <!-- Footer-->
    <footer class="mt-5 bg-dark d-flex flex-column justify-content-center align-items-center" id="footer">
        <div class="mb-2">
            <a href="https://github.com/BioWarlock/BioProfileKit">
                <img src="static/assets/github.svg" alt="Github" style="filter: brightness(0) invert(1);">
            </a>
        </div>
        <div>
            <p class="m-0 text-center text-white">Copyright &copy; JLU 2025</p>
        </div>
    </footer>
</div>

<!-- Bootstrap core JS-->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- Core theme JS-->
<script src="../static/js/scripts.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js" defer></script>
<!-- DataTables -->
<script src="https://cdn.datatables.net/2.3.1/js/dataTables.min.js" defer></script>
<script src="https://cdn.datatables.net/2.3.1/js/dataTables.bootstrap5.min.js" defer></script>
<script src="https://cdn.datatables.net/responsive/3.0.4/js/dataTables.responsive.min.js" defer></script>
<script src="https://cdn.datatables.net/responsive/3.0.4/js/responsive.bootstrap5.min.js" defer></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const itemsPerPage = {{ items_per_page }};
        const totalItems   = {{ columns|length }};
        const totalPages   = {{ total_pages }};
        let currentPage    = 1;
        let filterActive   = false;

        if (totalPages > 1) {
            generatePagination();
            updateDisplay();
        }

        function generatePagination() {
            const topPagination = document.getElementById('column-pagination');
            const bottomPagination = document.getElementById('column-pagination-bottom');

            [topPagination, bottomPagination].forEach(pagination => {
                if (!pagination) return; // Guard clause

                pagination.innerHTML = '';

                // First Button
                const firstLi = document.createElement('li');
                const firstDisabled = currentPage === 1;
                firstLi.className = `page-item ${firstDisabled ? 'disabled' : ''}`;
                firstLi.innerHTML = `<a class="page-link" href="#" data-page="1" title="First Page"${firstDisabled ? ' aria-disabled="true" tabindex="-1"' : ''}>≪</a>`;
                pagination.appendChild(firstLi);

                // Previous Button
                const prevLi = document.createElement('li');
                const prevDisabled = currentPage === 1;
                prevLi.className = `page-item ${prevDisabled ? 'disabled' : ''}`;
                prevLi.innerHTML = `<a class="page-link" href="#" data-page="${currentPage - 1}" title="Previous Page"${prevDisabled ? ' aria-disabled="true" tabindex="-1"' : ''}>&lt;</a>`;
                pagination.appendChild(prevLi);

                // Page Numbers
                let startPage = Math.max(1, currentPage - 2);
                let endPage = Math.min(totalPages, startPage + 4);

                if (endPage - startPage < 4) {
                    startPage = Math.max(1, endPage - 4);
                }

                // First page + ellipsis
                if (startPage > 1) {
                    if (startPage > 2) {
                        const ellipsisLi = document.createElement('li');
                        ellipsisLi.className = 'page-item disabled';
                        ellipsisLi.innerHTML = '<span class="page-link">...</span>';
                        pagination.appendChild(ellipsisLi);
                    }
                }

                // Page numbers
                for (let i = startPage; i <= endPage; i++) {
                    const li = document.createElement('li');
                    li.className = `page-item ${i === currentPage ? 'active' : ''}`;
                    li.innerHTML = `<a class="page-link" href="#" data-page="${i}">${i}</a>`;
                    pagination.appendChild(li);
                }

                // Last page + ellipsis
                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        const ellipsisLi = document.createElement('li');
                        ellipsisLi.className = 'page-item disabled';
                        ellipsisLi.innerHTML = '<span class="page-link">...</span>';
                        pagination.appendChild(ellipsisLi);
                    }
                }

                // Next Button
                const nextLi = document.createElement('li');
                const nextDisabled = currentPage === totalPages;
                nextLi.className = `page-item ${nextDisabled ? 'disabled' : ''}`;
                nextLi.innerHTML = `<a class="page-link" href="#" data-page="${currentPage + 1}" title="Next Page"${nextDisabled ? ' aria-disabled="true" tabindex="-1"' : ''}>&gt;</a>`;
                pagination.appendChild(nextLi);

                // Last Button
                const lastLi = document.createElement('li');
                const lastDisabled = currentPage === totalPages;
                lastLi.className = `page-item ${lastDisabled ? 'disabled' : ''}`;
                lastLi.innerHTML = `<a class="page-link" href="#" data-page="${totalPages}" title="Last Page"${lastDisabled ? ' aria-disabled="true" tabindex="-1"' : ''}>≫</a>`;
                pagination.appendChild(lastLi);
            });

            [topPagination, bottomPagination].forEach(pagination => {
                if (!pagination) return;

                pagination.addEventListener('click', function(e) {
                    e.preventDefault();
                    const page = parseInt(e.target.dataset.page);
                    if (page && page !== currentPage && page >= 1 && page <= totalPages) {
                        currentPage = page;
                        updateDisplay();
                        generatePagination();

                        // Scroll to top
                        document.getElementById('columns-container').scrollIntoView({
                            behavior: 'smooth'
                        });
                    }
                });
            });
        }

        function updateDisplay() {
            if (filterActive) return;
            const columnItems = document.querySelectorAll('.column-item');
            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;

            columnItems.forEach((item, index) => {
                if (index >= startIndex && index < endIndex) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                    // Collapse any open toggles on hidden pages
                    const collapseElement = item.querySelector('.collapse');
                    if (collapseElement && collapseElement.classList.contains('show')) {
                        const bsCollapse = new bootstrap.Collapse(collapseElement, {
                            toggle: false
                        });
                        bsCollapse.hide();
                    }
                }
            });

            // Update range display
            const currentRangeEl = document.getElementById('current-range');
            const currentPageInfoEl = document.getElementById('current-page-info');

            if (currentRangeEl) {
                const start = startIndex + 1;
                const end = Math.min(endIndex, totalItems);
                currentRangeEl.textContent = `${start}-${end}`;
            }

            if (currentPageInfoEl) {
                currentPageInfoEl.textContent = currentPage;
            }
        }

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            if (filterActive) return;
            if (e.target.tagName.toLowerCase() === 'input' || e.target.tagName.toLowerCase() === 'textarea') {
                return;
            }

            if (e.key === 'ArrowLeft' && currentPage > 1) {
                e.preventDefault();
                currentPage--;
                updateDisplay();
                generatePagination();
            } else if (e.key === 'ArrowRight' && currentPage < totalPages) {
                e.preventDefault();
                currentPage++;
                updateDisplay();
                generatePagination();
            }
        });

        document.addEventListener('click', function(e) {
            if (e.target.matches('a.cb-pink-link')) {
                e.preventDefault();
                const targetId = e.target.getAttribute('href').substring(1);
                const targetEl = document.getElementById(targetId);

                if (targetEl) {
                    const columnItem = targetEl.closest('.column-item');
                    if (columnItem) {
                        const columnItems = Array.from(document.querySelectorAll('.column-item'));
                        const targetIndex = columnItems.indexOf(columnItem);

                        if (targetIndex !== -1) {
                            const targetPage = Math.floor(targetIndex / itemsPerPage) + 1;

                            if (!filterActive && targetPage !== currentPage) {
                                currentPage = targetPage;
                                updateDisplay();
                                generatePagination();
                            }

                            setTimeout(() => {
                                if (!targetEl.classList.contains('show')) {
                                    new bootstrap.Collapse(targetEl, { toggle: true });
                                }

                                setTimeout(() => {
                                    targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                                }, 300);
                            }, 100);
                        }
                    }
                }
            }
        });

        // ── Filter logic ────────────────────────────────────────────────────
        const searchInput    = document.getElementById('col-search');
        const typeButtons    = document.querySelectorAll('[data-type-filter]');
        const qualityButtons = document.querySelectorAll('[data-quality]');
        const logicButtons   = document.querySelectorAll('[data-logic]');
        const resetBtn       = document.getElementById('reset-filters');
        const anyAlertBtn    = document.getElementById('any-alert-btn');
        const filterCountEl  = document.getElementById('filter-count');
        const badgeEl        = document.getElementById('active-filter-badge');

        // All data-quality keys that constitute an "alert" for the Any Alert shortcut
        const ALERT_FLAGS = [
            'missing','constant','correlation','infinity','sparse','outliers',
            'imbalanced','nzv','rare','mixedvalues','invalidseqs',
            'ambiguousbases','rcduplicates','lowcomplexity',
            'taxonomyinvalid','annotationinvalid','dataanomalies'
        ];

        let activeType      = 'all';
        let activeQualities = new Set();
        let filterLogic     = 'or';
        let anyAlertActive  = false;

        const TYPE_MAP = {
            numeric:     ['int64', 'float64'],
            categorical: ['object', 'str', 'bool'],
            bool:        ['bool'],
        };

        function updateBadge() {
            const n = activeQualities.size + (activeType !== 'all' ? 1 : 0) + (searchInput.value.trim() ? 1 : 0) + (anyAlertActive ? 1 : 0);
            if (badgeEl) { badgeEl.textContent = n; badgeEl.style.display = n > 0 ? 'inline-block' : 'none'; }
        }

        function applyFilters() {
            const query = searchInput.value.trim().toLowerCase();
            filterActive = query !== '' || activeType !== 'all' || activeQualities.size > 0 || anyAlertActive;
            document.querySelectorAll('#column-pagination, #column-pagination-bottom')
                .forEach(el => { if (el) el.style.opacity = filterActive ? '0.35' : '1'; });
            resetBtn.style.display = filterActive ? 'inline-block' : 'none';
            updateBadge();
            let visible = 0;
            document.querySelectorAll('.column-item').forEach(card => {
                let show = true;
                if (query && !card.dataset.name.includes(query)) show = false;
                if (show && activeType !== 'all') {
                    show = activeType === 'sequence'
                        ? (card.dataset.sequence && card.dataset.sequence !== 'None')
                        : (TYPE_MAP[activeType] || []).includes(card.dataset.type);
                }
                // Any Alert: show only columns that have at least one flag set to 'yes'
                if (show && anyAlertActive) {
                    show = ALERT_FLAGS.some(f => card.dataset[f] === 'yes');
                }
                if (show && activeQualities.size > 0) {
                    if (filterLogic === 'and') {
                        for (const q of activeQualities) { if (card.dataset[q] !== 'yes') { show = false; break; } }
                    } else {
                        let any = false;
                        for (const q of activeQualities) { if (card.dataset[q] === 'yes') { any = true; break; } }
                        if (!any) show = false;
                    }
                }
                card.style.display = show ? 'block' : 'none';
                if (show) visible++;
            });
            if (filterCountEl) filterCountEl.textContent = visible;
        }

        if (searchInput) searchInput.addEventListener('input', applyFilters);

        if (anyAlertBtn) anyAlertBtn.addEventListener('click', function () {
            anyAlertActive = !anyAlertActive;
            this.classList.toggle('btn-danger', anyAlertActive);
            this.classList.toggle('btn-outline-danger', !anyAlertActive);
            applyFilters();
        });

        typeButtons.forEach(btn => btn.addEventListener('click', function () {
            typeButtons.forEach(b => { b.classList.remove('active','btn-primary'); b.classList.add('btn-outline-primary'); });
            this.classList.add('active','btn-primary'); this.classList.remove('btn-outline-primary');
            activeType = this.dataset.typeFilter; applyFilters();
        }));

        qualityButtons.forEach(btn => btn.addEventListener('click', function () {
            const q = this.dataset.quality;
            if (activeQualities.has(q)) { activeQualities.delete(q); this.classList.remove('cbf-active'); }
            else                        { activeQualities.add(q);    this.classList.add('cbf-active'); }
            applyFilters();
        }));

        logicButtons.forEach(btn => btn.addEventListener('click', function () {
            logicButtons.forEach(b => { b.classList.remove('active','btn-secondary'); b.classList.add('btn-outline-secondary'); });
            this.classList.add('active','btn-secondary'); this.classList.remove('btn-outline-secondary');
            filterLogic = this.dataset.logic;
            if (activeQualities.size > 0) applyFilters();
        }));

        if (resetBtn) resetBtn.addEventListener('click', function () {
            searchInput.value = ''; activeType = 'all'; activeQualities.clear(); filterLogic = 'or';
            anyAlertActive = false;
            if (anyAlertBtn) { anyAlertBtn.classList.remove('btn-danger'); anyAlertBtn.classList.add('btn-outline-danger'); }
            typeButtons.forEach(b => { b.classList.remove('active','btn-primary'); b.classList.add('btn-outline-primary'); });
            const allBtn = document.querySelector('[data-type-filter="all"]');
            if (allBtn) { allBtn.classList.add('active','btn-primary'); allBtn.classList.remove('btn-outline-primary'); }
            qualityButtons.forEach(b => b.classList.remove('cbf-active'));
            logicButtons.forEach(b => { b.classList.remove('active','btn-secondary'); b.classList.add('btn-outline-secondary'); });
            const orBtn = document.querySelector('[data-logic="or"]');
            if (orBtn) { orBtn.classList.add('active','btn-secondary'); orBtn.classList.remove('btn-outline-secondary'); }
            filterActive = false; updateDisplay(); generatePagination();
            if (filterCountEl) filterCountEl.textContent = totalItems;
            if (badgeEl)       badgeEl.style.display = 'none';
            resetBtn.style.display = 'none';
            document.querySelectorAll('#column-pagination, #column-pagination-bottom')
                .forEach(el => { if (el) el.style.opacity = '1'; });
        });

    });

    document.getElementById('collapseAllBtn').addEventListener('click', () => {
        document.querySelectorAll('.column-item[style*="block"] .multi-collapse').forEach(el => {
            bootstrap.Collapse.getOrCreateInstance(el).hide();
        });
    });

    document.getElementById('expandAllBtn').addEventListener('click', () => {
        document.querySelectorAll('.column-item[style*="block"] .multi-collapse').forEach(el => {
            bootstrap.Collapse.getOrCreateInstance(el).show();
        });
    });
</script>

<!-- Colorblind mode toggle: persists the user's palette choice across pages via localStorage -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
    const pill  = document.getElementById('cbPill');
    const label = document.getElementById('cbLabel');
    const body  = document.body;
    function applyTheme(t) {
      body.dataset.cbTheme = t;
      label.textContent = t === 'colorblind' ? 'Standard Mode' : 'Colorblind Mode';
      pill.style.outline = t === 'colorblind' ? '2px solid #7DC3E8' : 'none';
    }
    const stored = localStorage.getItem('cb-theme');
    if (stored === 'colorblind') applyTheme('colorblind');
    pill.addEventListener('click', function () {
      const next = body.dataset.cbTheme === 'colorblind' ? 'internal' : 'colorblind';
      applyTheme(next); localStorage.setItem('cb-theme', next);
    });
  });
</script>

<!-- Colorblind mode pill (fixed, bottom-right) -->
<div id="cbPill" style="
    position:fixed; bottom:1.25rem; right:1.25rem; z-index:1050;
    display:flex; align-items:center; gap:.45rem;
    background:rgba(30,30,30,.82); backdrop-filter:blur(6px);
    border-radius:2rem; padding:.35rem .85rem .35rem .6rem;
    box-shadow:0 2px 8px rgba(0,0,0,.25); cursor:pointer;
    user-select:none; transition:opacity .2s;" title="Toggle colorblind-friendly palette">
  <!-- eye icon -->
  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="#ccc" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
  </svg>
  <span id="cbLabel" style="font-size:.78rem; color:#ddd; white-space:nowrap;">Colorblind Mode</span>
</div>
</body>
